# Copy to hostai.toml and edit for your account.
# Secrets (VAST_API_KEY, HF_TOKEN, SSH_PUBLIC_KEY, cache rclone passwords) still
# live in .env.

[hostai]
default_profile = "a6000"
profiles_file = "profiles.json"
# Override context size for all profiles (optional; normally set per-profile).
# ctx_size_override = 131072
# One-off Vast query override (optional).  Use with care: this bypasses profile
# disk and context handling.
# gpu_query_override = ""

[market]
max_dph = 0.80
# Container disk (GB).  35 GB is the default for the Q4_K_P main model
# (~16.7 GiB = 17.92 decimal GB), the FastMTP-32K draft (~0.84 GiB = 0.90
# decimal GB), ~5 GB of image/runtime overhead, and a safety margin.  You can
# override per-profile with "disk_gb" in profiles.json.
disk_gb = 35
# Reject offers that charge more than this USD per GB for download/upload.
# Set to 0.0 to require free traffic.  Also included in session-cost scoring.
max_inet_down_cost = 0.001
max_inet_up_cost = 0.001
allow_unverified = false
# Scoring: dph | perf | session
scoring_mode = "dph"
scoring_prompt_weight = 0.3
scoring_decode_weight = 0.7
min_historical_samples = 3
max_history_age_days = 30
# Estimated model+image download size used for startup/session-cost scoring.
# 18.83 decimal GB = Q4_K_P main (17.92) + FastMTP-32K draft (0.90).
model_download_gb = 18.83
image_size_gb = 5.0

[model]
hf_repo = "HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF"
hf_revision = "993a5971fda8f30dd1b7eb2654792ba4415c7460"
model = "Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf"
draft = "Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-FastMTP-32K.gguf"
use_fastmtp = true
reasoning_effort = "xhigh"
cache_ram = ""
ctx_checkpoints = ""
# Optional llama-server KV cache type (e.g. q4_0, f16). Leave empty for default.
cache_type_k = ""
cache_type_v = ""

[image]
# Repository only, WITHOUT a tag. hostai up appends the architecture image tag
# selected through profiles.json.
base = "ghcr.io/OWNER/REPO"
unsecure = false

[vast]
# Optional persistent volume for model files.
volume_id = ""
volume_mount_path = ""
shm_size_gb = ""
keep_on_failure = false
destroy_timeout_seconds = 45
pause_timeout_seconds = 60
# Idle and max-runtime safeguards. Set to empty/0 to disable.
idle_timeout_seconds = ""
max_runtime_seconds = ""
idle_poll_interval_seconds = 60
# Interruptible/bid instances. Set bid_price to the max $/h you are willing to pay.
interruptible = false
bid_price = ""
expected_session_seconds = ""
# Auto-start the watchdog after hostai up.
watchdog_auto_start = false
# Require a current `hostai validate --production` run before creating real
# Vast instances. Set to true to turn the validation record into a spending gate.
require_production_validation = false

[cache]
enabled = true
host = "your-cache-server.example.com"
port = 22
user = "qwen-cache"
root = "qwen-slot-cache"
max_gb = 80
session = "default"
use_shm = false
shm_min_gb = 0
shm_require = false
# Local SSH private key path (optional; a key is generated automatically if empty).
key = ""
# Fixed slot ID to load on cold start (0 = use first available).
slot_id = 0
# Override the local directory used to stage slot cache files.
local_dir = ""
# Treat a failed cache save as a fatal shutdown error.
require_save = false
# Set rclone = true to use rclone instead of SSH/rsync.
rclone = false
rclone_remote = ""
rclone_type = ""
rclone_url = ""
rclone_user = ""
rclone_password = ""

[monitor]
threshold_pct = 10
interval = 180
max_results = 5
auto_start = false
profile = ""
group = ""

[ssh]
local_port = 18080
local_port_auto = true
start_timeout = 1200

[bench]
max_tokens = 512
timeout = 900
temperature = 0.7

[proxy]
# Tokenize prompts locally before forwarding them to the remote llama-server.
tokenized_only = false
socket_path = ""
port = 0
tokenizer_model = "Qwen/Qwen3.8-27B"
# Pinned tokenizer revision (commit SHA). Pin this to a known-good commit so
# tokenization stays reproducible across Hugging Face updates.
tokenizer_revision = "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0"
cache_dir = ""
