#!/usr/bin/env bash
set -Eeuo pipefail

# Vast/API numeric values use a decimal point. Keep shell formatting independent
# of the user locale (e.g. de_DE uses a decimal comma).
export LC_NUMERIC=C

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT_DIR/.qwen-vast"
STATE_FILE="$STATE_DIR/state.json"
RUNS_DIR="${QWEN_RUNS_DIR:-$ROOT_DIR/.qwen-runs}"
KNOWN_HOSTS="$STATE_DIR/known_hosts"
TUNNEL_LOG="$STATE_DIR/tunnel.log"

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-lib.sh"

if [[ -f "$ROOT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
  set +a
fi

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-cache-lib.sh"
qwen_cache_load_config
qwen_cache_validate_config

YES=0
ARCHIVE=1
SAVE_CACHE=1
usage() {
  cat <<'USAGE'
Usage:
  ./qwen-down [--yes] [--no-archive] [--no-cache]

By default qwen-down first saves/uploads slot 0 to the persistent cache server,
then archives the remote llama-server log, a final GPU snapshot,
Prometheus metrics and sanitized session metadata into .qwen-runs/<session>/
before destroying the Vast instance.
USAGE
}

while (( $# > 0 )); do
  case "$1" in
    --yes) YES=1; shift ;;
    --no-archive) ARCHIVE=0; shift ;;
    --no-cache) SAVE_CACHE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo >&2 "ERROR: unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

for cmd in vastai jq python3 ssh scp curl; do
  command -v "$cmd" >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: $cmd"; exit 2; }
done

if [[ ! -f "$STATE_FILE" ]]; then
  echo "No local qwen38 Vast state found."
  exit 0
fi

instance_id="$(jq -r '.instance_id // empty' "$STATE_FILE")"
tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
gpu="$(jq -r '.gpu // "unknown"' "$STATE_FILE")"
dph="$(jq -r '.dph // 0' "$STATE_FILE")"
run_dir="$(jq -r '.run_dir // empty' "$STATE_FILE")"
ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"
local_port="$(jq -r '.local_port // 18080' "$STATE_FILE")"
api_key="$(jq -r '.api_key // empty' "$STATE_FILE")"
started_epoch="$(jq -r '.started_epoch // .run_started_epoch // empty' "$STATE_FILE")"
model="$(jq -r '.model // empty' "$STATE_FILE")"
ctx_size="$(jq -r '.ctx_size // 0' "$STATE_FILE")"
profile="$(jq -r '.profile // "unknown"' "$STATE_FILE")"
hf_revision="$(jq -r '.hf_revision // empty' "$STATE_FILE")"
hf_revision="${hf_revision:-${HF_REVISION:-993a5971fda8f30dd1b7eb2654792ba4415c7460}}"
use_fastmtp="$(jq -r '.use_fastmtp // 1' "$STATE_FILE")"
llama_commit="$(jq -r '.llama_cpp_commit // empty' "$STATE_FILE")"
cache_signature="$(jq -r '.slot_cache_signature // empty' "$STATE_FILE")"
# If the state was written by a qwen-up with the corrupted llama_commit bug,
# reset both so qwen-down re-fetches and re-computes the correct signature.
if [[ -n "$llama_commit" && ! "$llama_commit" =~ ^[a-f0-9]+$ ]]; then
  llama_commit=""
  cache_signature=""
fi
cache_type_k="$(jq -r '.cache_type_k // "default"' "$STATE_FILE")"
cache_type_v="$(jq -r '.cache_type_v // "default"' "$STATE_FILE")"

# Cache destination is part of the run state so changing .env while an instance
# is running cannot accidentally upload the snapshot to another namespace.
state_cache_enabled="$(jq -r '.slot_cache_enabled // 0' "$STATE_FILE")"
if [[ "$state_cache_enabled" == "1" ]]; then
  QWEN_SLOT_CACHE_ENABLED=1
  QWEN_SLOT_CACHE_HOST="$(jq -r '.slot_cache_host // empty' "$STATE_FILE")"
  QWEN_SLOT_CACHE_PORT="$(jq -r '.slot_cache_port // 22' "$STATE_FILE")"
  QWEN_SLOT_CACHE_USER="$(jq -r '.slot_cache_user // empty' "$STATE_FILE")"
  QWEN_SLOT_CACHE_ROOT="$(jq -r '.slot_cache_root // empty' "$STATE_FILE")"
  QWEN_SLOT_CACHE_SESSION="$(jq -r '.slot_cache_session // "default"' "$STATE_FILE")"
  QWEN_SLOT_CACHE_MAX_GB="$(jq -r '.slot_cache_max_gb // 80' "$STATE_FILE")"
  qwen_cache_validate_config
fi

# Refresh connection details even for states created by older qwen-up versions.
# A tunnel is best-effort here: remote log archival only needs direct SSH, but
# /metrics uses the local tunnel when available.
qwen_refresh_ssh_state >/dev/null 2>&1 || true
qwen_ensure_tunnel 1 >/dev/null 2>&1 || true
ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"
tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
local_port="$(jq -r '.local_port // 18080' "$STATE_FILE")"

if (( YES == 0 )); then
  printf 'Destroy Vast instance %s (%s, $%s/h)? [y/N] ' "$instance_id" "$gpu" "$dph"
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Cancelled."; exit 0; }
fi

# A background market monitor is tied to the running instance price. Stop it
# before saving/destroying so it cannot keep polling stale state.
if [[ -x "$ROOT_DIR/qwen-monitor" ]]; then
  "$ROOT_DIR/qwen-monitor" stop --quiet >/dev/null 2>&1 || true
fi

# Older state files may predate telemetry. Create a recovery directory instead of
# throwing away everything we can still collect at shutdown.
if [[ -z "$run_dir" && -n "$instance_id" ]]; then
  recovery_id="$(date -u +%Y%m%dT%H%M%SZ)-recovered-${instance_id}"
  run_dir="$RUNS_DIR/$recovery_id"
  mkdir -p "$run_dir"
  chmod 700 "$RUNS_DIR" "$run_dir" 2>/dev/null || true
  echo "[archive] legacy state: using recovery run $run_dir"
  tmp_state="$(mktemp)"
  jq --arg run_dir "$run_dir" --arg run_id "$recovery_id" \
    '. + {run_dir:$run_dir, run_id:$run_id}' "$STATE_FILE" > "$tmp_state"
  mv "$tmp_state" "$STATE_FILE"
fi

save_slot_cache() {
  [[ "$SAVE_CACHE" == "1" ]] || { echo "[slot-cache] skipped by --no-cache"; return 0; }
  [[ "$state_cache_enabled" == "1" ]] || return 0
  [[ -n "$api_key" ]] || { echo >&2 "[slot-cache] WARNING: API key missing; cannot save slot"; return 20; }

  # Re-resolve after the user confirmation: startup/tunnel state may have changed.
  endpoint="$(qwen_refresh_ssh_state 2>/dev/null || true)"
  [[ -n "$endpoint" ]] || { echo >&2 "[slot-cache] WARNING: Vast SSH endpoint unavailable; cannot upload slot"; return 21; }
  IFS=$'\t' read -r cache_vast_user cache_vast_host cache_vast_port _ <<<"$endpoint"
  mapfile -d '' -t cache_vast_ssh_opts < <(qwen_ssh_opts "$cache_vast_port")

  qwen_cache_require_key || return 22
  if ! qwen_cache_copy_key_to_vast "$cache_vast_user" "$cache_vast_host" "$cache_vast_port"; then
    echo >&2 "[slot-cache] WARNING: could not install cache key on Vast host"
    return 23
  fi

  if [[ -z "$llama_commit" ]]; then
    build_json="$(ssh "${cache_vast_ssh_opts[@]}" "${cache_vast_user}@${cache_vast_host}" 'cat /etc/qwen38-build.json 2>/dev/null || true' 2>/dev/null || true)"
    llama_commit="$(jq -r '.llama_cpp_commit // "unknown"' <<<"${build_json:-{\}}" 2>/dev/null)" || llama_commit="unknown"
    [[ "$llama_commit" == "unknown" || "$llama_commit" =~ ^[a-f0-9]+$ ]] || llama_commit="unknown"
  fi
  if [[ -z "$cache_signature" ]]; then
    cache_signature="$(qwen_cache_signature "$llama_commit" "$model" "$hf_revision" "$ctx_size" "$use_fastmtp" "$cache_type_k" "$cache_type_v")"
  fi
  cache_remote_dir="$(qwen_cache_remote_dir "$cache_signature")"

  # The slot endpoint writes the state to --slot-save-path/current.bin on the
  # Vast NVMe. This can take a while for a long Qwen3.8 context.
  echo "[slot-cache] saving slot ${QWEN_SLOT_CACHE_SLOT_ID} before destroy..."
  save_response="$run_dir/cache-save.json"
  set +e
  curl -fsS --connect-timeout 3 --max-time 1800 \
    -X POST \
    -H "Authorization: Bearer ${api_key}" \
    -H 'Content-Type: application/json' \
    -d '{"filename":"current.bin"}' \
    "http://127.0.0.1:${local_port}/slots/${QWEN_SLOT_CACHE_SLOT_ID}?action=save" > "$save_response"
  cache_save_api_rc=$?
  set -e
  if (( cache_save_api_rc != 0 )); then
    echo >&2 "[slot-cache] WARNING: llama.cpp slot save API failed"
    return 24
  fi

  n_saved="$(jq -r '.n_saved // 0' "$save_response" 2>/dev/null || echo 0)"
  n_written="$(jq -r '.n_written // 0' "$save_response" 2>/dev/null || echo 0)"
  save_ms="$(jq -r '.timings.save_ms // 0' "$save_response" 2>/dev/null || echo 0)"
  if [[ ! "$n_saved" =~ ^[0-9]+$ ]] || (( n_saved <= 0 )); then
    echo "[slot-cache] slot is empty; nothing to persist."
    jq '. + {slot_cache_save:"empty"}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    return 0
  fi
  echo "[slot-cache] llama.cpp wrote ${n_saved} tokens / ${n_written} bytes (${save_ms} ms); uploading to ${QWEN_SLOT_CACHE_HOST}..."

  metadata_tmp="$(mktemp)"
  python3 - "$metadata_tmp" "$cache_signature" "$QWEN_SLOT_CACHE_SESSION" "$model" "$hf_revision" "$ctx_size" "$use_fastmtp" "$llama_commit" "$profile" "$instance_id" "$n_saved" "$n_written" "$save_ms" "$QWEN_SLOT_CACHE_SLOT_ID" <<'PYMETA'
import json, pathlib, sys, datetime
(path, signature, session, model, revision, ctx, fastmtp, commit, profile,
 instance_id, n_saved, n_written, save_ms, slot_id) = sys.argv[1:]
obj = {
    "schema_version": 1,
    "saved_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "signature": signature,
    "session": session,
    "model": model,
    "hf_revision": revision,
    "ctx_size": int(ctx),
    "use_fastmtp": int(fastmtp),
    "llama_cpp_commit": commit,
    "profile": profile,
    "source_instance_id": int(instance_id),
    "slot_id": int(slot_id),
    "n_saved": int(n_saved),
    "n_written": int(n_written),
    "save_ms": float(save_ms),
}
pathlib.Path(path).write_text(json.dumps(obj, indent=2) + "\n")
PYMETA
  scp_opts=(
    -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
    -o StrictHostKeyChecking=accept-new -o "UserKnownHostsFile=$KNOWN_HOSTS" -P "$cache_vast_port"
  )
  if ! scp -q "${scp_opts[@]}" "$metadata_tmp" "${cache_vast_user}@${cache_vast_host}:${QWEN_SLOT_CACHE_LOCAL_DIR}/current.json.tmp"; then
    echo >&2 "[slot-cache] could not copy slot metadata to Vast host"
    rm -f "$metadata_tmp"
    return 26
  fi
  rm -f "$metadata_tmp"
  if ! ssh "${cache_vast_ssh_opts[@]}" "${cache_vast_user}@${cache_vast_host}" \
      "mv '${QWEN_SLOT_CACHE_LOCAL_DIR}/current.json.tmp' '${QWEN_SLOT_CACHE_LOCAL_DIR}/current.json' && chmod 600 '${QWEN_SLOT_CACHE_LOCAL_DIR}/current.json'"; then
    echo >&2 "[slot-cache] could not stage slot metadata on Vast host"
    return 27
  fi

  if qwen_cache_upload_from_vast "$cache_vast_user" "$cache_vast_host" "$cache_vast_port" "$cache_signature" | tee "$run_dir/cache-upload.log"; then
    jq --arg signature "$cache_signature" --arg remote_dir "$cache_remote_dir" --argjson n_saved "$n_saved" --argjson n_written "$n_written" \
      '. + {slot_cache_save:"uploaded",slot_cache_signature:$signature,slot_cache_remote_dir:$remote_dir,slot_cache_n_saved:$n_saved,slot_cache_bytes_saved:$n_written}' \
      "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    chmod 600 "$STATE_FILE"
    echo "[slot-cache] persisted: ${QWEN_SLOT_CACHE_USER}@${QWEN_SLOT_CACHE_HOST}:${cache_remote_dir}/current.bin"
    return 0
  fi
  echo >&2 "[slot-cache] WARNING: upload failed"
  return 25
}

archive_session() {
  [[ -n "$run_dir" ]] || { echo >&2 "[archive] no run directory available; skipping telemetry archive"; return 0; }
  mkdir -p "$run_dir"
  chmod 700 "$run_dir" 2>/dev/null || true
  echo "[archive] saving telemetry to $run_dir"

  # Preserve a sanitized copy even if SSH is already unavailable.
  jq 'del(.api_key,.tunnel_pid)' "$STATE_FILE" > "$run_dir/state-before-destroy.json" 2>/dev/null || true
  vastai show instance "$instance_id" --raw > "$run_dir/vast-final.json" 2>/dev/null || true

  # Scrape counters before killing the tunnel. This is best effort: benchmarks
  # already save per-request timings, so shutdown must never depend on metrics.
  if [[ -n "$api_key" ]]; then
    curl -fsS --connect-timeout 2 --max-time 8 \
      -H "Authorization: Bearer $api_key" \
      "http://127.0.0.1:${local_port}/metrics" \
      > "$run_dir/metrics-final.prom" 2>/dev/null || true
  fi

  if [[ -n "$ssh_url" ]]; then
    read -r ssh_user ssh_host ssh_port < <(python3 - "$ssh_url" <<'PY'
from urllib.parse import urlparse
import sys
u = urlparse(sys.argv[1])
print(u.username or "root", u.hostname or "", u.port or 22)
PY
    )
    if [[ -n "$ssh_host" ]]; then
      qwen_ssh_sanitize_known_hosts "$ssh_host" "$ssh_port"
      ssh_opts=(
        -o BatchMode=yes
        -o ConnectTimeout=8
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -o "UserKnownHostsFile=$KNOWN_HOSTS"
        -p "$ssh_port"
      )
      ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" \
        'cat /var/log/qwen38/server.log 2>/dev/null || true' \
        > "$run_dir/server.log" 2>/dev/null || true
      ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" \
        'nvidia-smi --query-gpu=timestamp,index,name,driver_version,utilization.gpu,memory.used,memory.total,power.draw,power.limit,temperature.gpu --format=csv,noheader 2>/dev/null || nvidia-smi 2>/dev/null || true' \
        > "$run_dir/gpu-final.txt" 2>/dev/null || true
    fi
  fi
}

cache_save_rc=0
if [[ "$state_cache_enabled" == "1" && "$SAVE_CACHE" == "1" ]]; then
  set +e
  save_slot_cache
  cache_save_rc=$?
  set -e
  if (( cache_save_rc != 0 )); then
    if [[ "$QWEN_SLOT_CACHE_REQUIRE_SAVE" == "1" ]]; then
      echo >&2 "ERROR: slot cache save/upload failed (rc=$cache_save_rc); QWEN_SLOT_CACHE_REQUIRE_SAVE=1, so the Vast instance was NOT destroyed."
      exit 4
    fi
    echo >&2 "[slot-cache] continuing shutdown despite cache failure (rc=$cache_save_rc) to stop billing."
    jq --argjson rc "$cache_save_rc" '. + {slot_cache_save:"failed",slot_cache_save_rc:$rc}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
  fi
fi

if (( ARCHIVE == 1 )); then
  archive_session || echo >&2 "[archive] warning: telemetry archive was incomplete"
fi

# End the local tunnel only after metrics/logs have been copied.
if [[ -n "$tunnel_pid" ]] && kill -0 "$tunnel_pid" >/dev/null 2>&1; then
  kill "$tunnel_pid" >/dev/null 2>&1 || true
fi

destroy_outcome="none"
if [[ -n "$instance_id" ]]; then
  echo "Destroying Vast instance $instance_id (non-interactive, timeout=${QWEN_DESTROY_TIMEOUT_SECONDS:-45}s)..."
  set +e
  qwen_destroy_instance "$instance_id"
  destroy_rc=$?
  set -e
  destroy_output="$QWEN_DESTROY_OUTPUT"
  destroy_outcome="$QWEN_DESTROY_OUTCOME"
  [[ -n "$destroy_output" ]] && printf '%s\n' "$destroy_output"

  # 404 is success for shutdown: the required postcondition is that the rental
  # no longer exists. A real timeout/error keeps local state for a safe retry.
  if [[ "$destroy_outcome" == "timeout" ]]; then
    echo >&2 "ERROR: Vast destroy exceeded ${QWEN_DESTROY_TIMEOUT_SECONDS:-45}s. State was kept so you can retry; verify the instance in Vast before assuming billing stopped."
    exit 3
  elif (( destroy_rc != 0 )); then
    echo >&2 "ERROR: Vast destroy failed (rc=$destroy_rc). State was kept so you can retry."
    exit 3
  fi
fi

ended_epoch="$(date +%s)"
ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [[ "$started_epoch" =~ ^[0-9]+$ ]]; then
  duration_seconds="$(( ended_epoch - started_epoch ))"
else
  duration_seconds=0
fi
estimated_cost="$(python3 - "$duration_seconds" "$dph" <<'PY'
import sys
seconds=float(sys.argv[1] or 0)
dph=float(sys.argv[2] or 0)
print(f"{seconds / 3600.0 * dph:.8f}")
PY
)"

if [[ -n "$run_dir" ]]; then
  python3 - "$STATE_FILE" "$run_dir/metadata.json" "$ended_at" "$ended_epoch" "$duration_seconds" "$estimated_cost" "$destroy_outcome" <<'PY'
import json, pathlib, sys
state_path, metadata_path, ended_at, ended_epoch, duration, cost, destroy_outcome = sys.argv[1:]
try:
    state = json.loads(pathlib.Path(state_path).read_text())
except Exception:
    state = {}
state.pop("api_key", None)
state.pop("tunnel_pid", None)
state.update({
    "status": "destroyed",
    "ended_at": ended_at,
    "ended_epoch": int(ended_epoch),
    "duration_seconds": int(duration),
    "estimated_compute_cost_usd": float(cost),
    "destroy_outcome": destroy_outcome,
})
pathlib.Path(metadata_path).write_text(json.dumps(state, indent=2, ensure_ascii=False))
PY
  chmod 600 "$run_dir/metadata.json" 2>/dev/null || true
fi

rm -rf "$STATE_DIR"
if [[ "$destroy_outcome" == "already_absent" ]]; then
  final_action="Already absent"
else
  final_action="Destroyed"
fi
# Format the cost in Python as well; this avoids locale-sensitive bash printf
# conversions on systems using decimal commas.
summary_cost="$(python3 - "$estimated_cost" <<'PY'
import sys
print(f"{float(sys.argv[1]):.4f}")
PY
)"
printf '%s. Session duration: %ss | estimated compute: $%s\n' "$final_action" "$duration_seconds" "$summary_cost"
if [[ -n "$run_dir" ]]; then
  if (( ARCHIVE == 1 )); then
    printf 'Archived run: %s\n' "$run_dir"
  else
    printf 'Run metadata: %s\n' "$run_dir"
  fi
  printf 'Compare benchmarks: ./qwen-results\n'
fi
