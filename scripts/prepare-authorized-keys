#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SSH_DIR="$ROOT_DIR/ssh"
OUT="$SSH_DIR/authorized_keys.generated"
TMP="$(mktemp)"
trap 'rm -f "$TMP" "$TMP.keys"' EXIT
mkdir -p "$SSH_DIR"

# A public key is not a secret. An explicit HOSTAI_SSH_PUBLIC_KEY wins over the
# automatic GitHub-account lookup so a single deliberately chosen key can be
# baked when desired.
if [[ -n "${HOSTAI_SSH_PUBLIC_KEY:-}" ]]; then
  printf '%s\n' "$HOSTAI_SSH_PUBLIC_KEY" >> "$TMP"
else
  # By default use the GitHub account that owns the repository. GitHub exposes
  # authentication public keys at https://github.com/<user>.keys.
  GITHUB_USER="${HOSTAI_SSH_GITHUB_USER:-${HOSTAI_SSH_DEFAULT_GITHUB_USER:-${GITHUB_REPOSITORY_OWNER:-}}}"
  if [[ -n "$GITHUB_USER" ]]; then
    echo "[ssh-keys] fetching public SSH keys for GitHub user: $GITHUB_USER"
    curl -fsSL --retry 3 --connect-timeout 10 "https://github.com/${GITHUB_USER}.keys" >> "$TMP" || {
      echo >&2 "ERROR: could not fetch https://github.com/${GITHUB_USER}.keys"
      exit 2
    }
  fi
fi

# Allow explicit committed keys too. Comments/blank lines are ignored.
if [[ -f "$SSH_DIR/authorized_keys" ]]; then
  cat "$SSH_DIR/authorized_keys" >> "$TMP"
fi

# Keep only plausible OpenSSH public-key records and de-duplicate them. The key
# material is public, but do not echo full keys into CI logs unnecessarily.
grep -E '^[[:space:]]*(ssh-|ecdsa-|sk-)[^[:space:]]+[[:space:]]+[^[:space:]]+' "$TMP" \
  | sed -E 's/^[[:space:]]+//' \
  | awk '!seen[$0]++' > "$TMP.keys" || true

if [[ ! -s "$TMP.keys" ]]; then
  cat >&2 <<'MSG'
ERROR: no SSH public key is available for the runtime image.
Set one of:
  - GitHub repository variable HOSTAI_SSH_PUBLIC_KEY
  - GitHub repository variable HOSTAI_SSH_GITHUB_USER
  - ssh/authorized_keys in the repository
For GitHub Actions, HOSTAI_SSH_GITHUB_USER defaults to the repository owner.
MSG
  exit 3
fi

install -m 0600 "$TMP.keys" "$OUT"
count="$(wc -l < "$OUT" | tr -d ' ')"
echo "[ssh-keys] prepared $count public key(s) for image build"

# Fingerprints are useful in CI without printing the keys themselves.
if command -v ssh-keygen >/dev/null 2>&1; then
  while IFS= read -r key; do
    one="$(mktemp)"
    printf '%s\n' "$key" > "$one"
    ssh-keygen -lf "$one" 2>/dev/null | sed 's/^/[ssh-keys] /' || true
    rm -f "$one"
  done < "$OUT"
fi
