#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fail() { echo >&2 "validate-repo: $*"; exit 1; }
require_file() { [[ -f "$1" ]] || fail "missing required file: $1"; }
require_grep() { local pat="$1" file="$2"; grep -Eq -- "$pat" "$file" || fail "$file is missing required marker: $pat"; }

for f in \
  profiles.json Dockerfile .env.example .qwen-lib.sh .qwen-cache-lib.sh \
  qwen-up qwen-down qwen-status qwen-monitor qwen-bench qwen-results qwen-cache-setup \
  start.sh entrypoint.sh qwen-init-ssh.sh \
  .github/workflows/docker.yml .github/workflows/docker-self-hosted.yml; do
  require_file "$f"
done

# Syntax first.
bash -n start.sh entrypoint.sh qwen-init-ssh.sh .qwen-lib.sh .qwen-cache-lib.sh \
  qwen-up qwen-down qwen-status qwen-monitor qwen-bench qwen-results qwen-cache-setup \
  scripts/prepare-authorized-keys scripts/validate-repo

jq -e '
  .schema_version == 1 and
  ([.images[].cuda_arch | tostring] | sort | unique) == ["120","86","89"] and
  any(.profiles[]; .ctx_size == 65536) and
  any(.profiles[]; .ctx_size == 131072) and
  any(.profiles[]; .ctx_size == 262144) and
  ((.monitor_hardware.gpu_ranks // []) | length) > 0 and
  (.market_policy.require_free_traffic == true) and
  (.market_policy.max_inet_down_cost == 0.001) and
  (.market_policy.max_inet_up_cost == 0.001)
' profiles.json >/dev/null || fail "profiles.json lost a required cumulative profile/market feature"

# Compiler cache + persistent local builder.
require_grep 'ARG CCACHE_SEED=' Dockerfile
require_grep 'CMAKE_CUDA_COMPILER_LAUNCHER=ccache' Dockerfile
require_grep 'ccache-v4-' .github/workflows/docker.yml
require_grep 'save-always:[[:space:]]*true' .github/workflows/docker.yml
require_grep 'name:[[:space:]]*qwen38-local-builder' .github/workflows/docker-self-hosted.yml
require_grep 'keep-state:[[:space:]]*true' .github/workflows/docker-self-hosted.yml

# Runtime dependency and fail-open SSH guards for the slim final image.
require_grep 'libgomp1' Dockerfile
require_grep 'libgomp\.so\.1' Dockerfile
require_grep 'runtime preflight failed' start.sh
require_grep 'runtime dependency failure' qwen-up
require_grep '/run/qwen38/start.exitcode' entrypoint.sh
require_grep 'keeping container alive for SSH diagnostics' entrypoint.sh
require_grep 'sshd -D -e' entrypoint.sh
require_grep 'restarting sshd' entrypoint.sh
require_grep 'SSH_RESTART_DELAY_SECONDS' entrypoint.sh
require_grep 'remote model server exited' qwen-up

# Self-managed SSH and tunnel recovery.
require_grep 'qwen_ensure_tunnel' qwen-up
require_grep 'LOCAL_PORT_AUTO' qwen-up
require_grep 'qwen_ensure_tunnel' qwen-status
require_grep 'qwen_destroy_instance' .qwen-lib.sh
require_grep 'qwen_destroy_instance[[:space:]]+"\$instance_id"' qwen-down
require_grep 'qwen_destroy_instance[[:space:]]+"\$instance_id"' qwen-up
if grep -Eq 'vastai[[:space:]]+destroy[[:space:]]+instance' qwen-up; then
  fail "qwen-up contains a direct Vast destroy call; use qwen_destroy_instance so -y/timeout handling cannot regress"
fi

# Persistent llama.cpp slot/KV cache.
require_grep '--slot-save-path' start.sh
require_grep '/slots/.+action=restore|action=restore' qwen-up
require_grep '/slots/.+action=save|action=save' qwen-down
require_grep 'cache_n' qwen-bench
require_grep 'QWEN_SLOT_CACHE_HOST' .env.example

# Market monitor policy: exact context + same/better hardware + free traffic.
require_grep 'gpu_ranks' qwen-monitor
require_grep 'ctx_size == \$ctx' qwen-monitor
require_grep 'inet_down_cost' qwen-monitor
require_grep 'inet_up_cost' qwen-monitor
require_grep 'inet_down_cost' qwen-up
require_grep 'inet_up_cost' qwen-up
require_grep 'QWEN_ALLOW_PAID_TRAFFIC' .env.example

# Local transient/secrets must remain ignored.
require_grep '^\.env$' .gitignore
require_grep '^\.qwen-cache/' .gitignore
require_grep '^\.qwen-runs/' .gitignore
require_grep '^\.qwen-vast/' .gitignore

echo "validate-repo: OK"
