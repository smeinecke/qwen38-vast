#!/usr/bin/env bash
set -Eeuo pipefail
export LC_NUMERIC=C

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-lib.sh"
qwen_source_env

PROFILES_FILE="${QWEN_PROFILES_FILE:-$ROOT_DIR/profiles.json}"

usage() {
  cat <<'USAGE'
Usage:
  ./qwen-lookup [PROFILE] [options]

List currently available Vast offers for a profile without renting.

Options:
  --max-price USD/HOUR  maximum all-in $/h (overrides MAX_DPH/.env)
  --allow-paid-traffic  do not require free/cheap traffic
  --unverified          also consider unverified/unknown hosts
  --max-results N       number of results to show (default: 10)
  --json                output raw JSON array
  --csv                 output CSV
  -h, --help            show this help

Examples:
  ./qwen-lookup v100-128k --max-price 0.3 --allow-paid-traffic --unverified
  ./qwen-lookup a6000 --max-price 0.45 --json
USAGE
}

profile_arg=""
max_price_arg=""
allow_paid_arg=""
unverified_arg=""
max_results_arg="10"
format="table"

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -p|--profile)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --profile requires a value"; exit 2; }
      profile_arg="$2"; shift 2 ;;
    --max-price)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --max-price requires a value"; exit 2; }
      [[ "${2:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo >&2 "ERROR: --max-price must be a positive number"; exit 2; }
      max_price_arg="$2"; shift 2 ;;
    --allow-paid-traffic) allow_paid_arg=1; shift ;;
    --unverified) unverified_arg=1; shift ;;
    --max-results)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --max-results requires a value"; exit 2; }
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo >&2 "ERROR: --max-results must be an integer"; exit 2; }
      max_results_arg="$2"; shift 2 ;;
    --json) format="json"; shift ;;
    --csv) format="csv"; shift ;;
    -*)
      echo >&2 "ERROR: unknown option: $1"; usage >&2; exit 2 ;;
    *)
      if [[ -n "$profile_arg" ]]; then
        echo >&2 "ERROR: multiple profiles supplied ('$profile_arg' and '$1')"; usage >&2; exit 2
      fi
      profile_arg="$1"; shift ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: jq"; exit 2; }
command -v vastai >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: vastai"; exit 2; }

[[ -f "$PROFILES_FILE" ]] || { echo >&2 "ERROR: profiles file not found: $PROFILES_FILE"; exit 2; }
jq -e '.schema_version == 1 and (.images|type=="array") and (.profiles|type=="array")' "$PROFILES_FILE" >/dev/null \
  || { echo >&2 "ERROR: invalid profiles file: $PROFILES_FILE"; exit 2; }

DEFAULT_PROFILE="$(jq -r '.default_profile // "a6000"' "$PROFILES_FILE")"
PROFILE_INPUT="${profile_arg:-${QWEN_PROFILE:-$DEFAULT_PROFILE}}"
PROFILE_JSON="$(jq -c --arg p "$PROFILE_INPUT" '
  [.profiles[] | select(.name == $p or (((.aliases // []) | index($p)) != null))][0] // empty
' "$PROFILES_FILE")"
if [[ -z "$PROFILE_JSON" || "$PROFILE_JSON" == "null" ]]; then
  echo >&2 "ERROR: unknown profile '$PROFILE_INPUT'"
  usage >&2
  exit 2
fi

PROFILE="$(jq -r '.name' <<<"$PROFILE_JSON")"
IMAGE_NAME="$(jq -r '.image' <<<"$PROFILE_JSON")"
PROFILE_CTX_SIZE="$(jq -r '.ctx_size' <<<"$PROFILE_JSON")"
PROFILE_GPU_QUERY="$(jq -r '.gpu_query' <<<"$PROFILE_JSON")"

IMAGE_JSON="$(jq -c --arg image "$IMAGE_NAME" '[.images[] | select(.name == $image)][0] // empty' "$PROFILES_FILE")"
if [[ -z "$IMAGE_JSON" || "$IMAGE_JSON" == "null" ]]; then
  echo >&2 "ERROR: profile '$PROFILE' references unknown image '$IMAGE_NAME'"
  exit 2
fi

CUDA_ARCH="$(jq -r '.cuda_arch' <<<"$IMAGE_JSON")"

if [[ -n "$max_price_arg" ]]; then
  MAX_DPH="$max_price_arg"
fi
MAX_DPH="${MAX_DPH:-0.80}"

if [[ -n "$allow_paid_arg" ]]; then
  QWEN_ALLOW_PAID_TRAFFIC="$allow_paid_arg"
fi
# qwen-lookup is a market scanner: by default it shows paid-traffic offers too,
# so cheap machines don't get hidden. Set QWEN_ALLOW_PAID_TRAFFIC=0 to hide them.
ALLOW_PAID_TRAFFIC="${QWEN_ALLOW_PAID_TRAFFIC:-1}"

REQUIRE_FREE_TRAFFIC="$(jq -r '.market_policy.require_free_traffic // true' "$PROFILES_FILE")"
MAX_INET_DOWN_COST="${QWEN_MAX_INET_DOWN_COST:-$(jq -r '.market_policy.max_inet_down_cost // 0' "$PROFILES_FILE")}"
MAX_INET_UP_COST="${QWEN_MAX_INET_UP_COST:-$(jq -r '.market_policy.max_inet_up_cost // 0' "$PROFILES_FILE")}"

CTX_SIZE="${CTX_SIZE_OVERRIDE:-$PROFILE_CTX_SIZE}"
GPU_QUERY="${GPU_QUERY_OVERRIDE:-$PROFILE_GPU_QUERY}"

if [[ "${unverified_arg:-${QWEN_ALLOW_UNVERIFIED:-0}}" == "1" ]]; then
  GPU_QUERY="$(sed -E 's/(^|[[:space:]])reliability[[:space:]]*(>=?|<=?|=)[^[:space:]]*//g' <<<"$GPU_QUERY")"
  GPU_QUERY="$(echo -n "$GPU_QUERY" | tr -s ' ')"
  GPU_QUERY+=' verification in ["verified","unverified","deverified"]'
fi

if [[ "$REQUIRE_FREE_TRAFFIC" == "true" && "$ALLOW_PAID_TRAFFIC" != "1" ]]; then
  GPU_QUERY+=" inet_down_cost<=${MAX_INET_DOWN_COST} inet_up_cost<=${MAX_INET_UP_COST}"
fi

if [[ "$GPU_QUERY" != *"dph"* ]]; then
  GPU_QUERY+=" dph_total <= $MAX_DPH"
fi

DISK_GB="${DISK_GB:-100}"

echo "[profile] $PROFILE | sm_$CUDA_ARCH | ctx=$CTX_SIZE | image=$IMAGE_NAME"
echo "[search]  $GPU_QUERY"

offers_raw="$(vastai search offers "$GPU_QUERY" --order dph_total --limit 50 --storage "$DISK_GB" --raw)"

offers="$(jq -c '
  if type == "array" then .
  elif (.offers? | type) == "array" then .offers
  elif .offers? then [.offers]
  elif (.bundles? | type) == "array" then .bundles
  else [] end
' <<<"$offers_raw")"

matches="$(jq -c --argjson max "$MAX_DPH" \
  --arg require_free "$REQUIRE_FREE_TRAFFIC" \
  --argjson allow_paid "$ALLOW_PAID_TRAFFIC" \
  --argjson max_down "$MAX_INET_DOWN_COST" \
  --argjson max_up "$MAX_INET_UP_COST" '
  [ .[]
    | ._effective_dph = (.dph_total // 999999)
    | select(._effective_dph <= $max)
    | select(
        if ($require_free == "true" and $allow_paid != 1) then
          ((.inet_down_cost // 999999) <= $max_down and (.inet_up_cost // 999999) <= $max_up)
        else true end
      )
  ]
  | sort_by(._effective_dph)
' <<<"$offers")"

if [[ "$matches" == "null" || -z "$matches" ]]; then
  echo "No matching offers below \$$MAX_DPH/h."
  exit 0
fi

if [[ "$format" == "json" ]]; then
  jq -c --argjson n "$max_results_arg" '[limit($n; .[])]' <<<"$matches"
  exit 0
fi

if [[ "$format" == "csv" ]]; then
  jq -r --argjson n "$max_results_arg" '
    [limit($n; .[])]
    | (.[0] | keys_unsorted) as $keys
    | ($keys | @csv),
      (.[] | [.[$keys[]]] | @csv)
  ' <<<"$matches"
  exit 0
fi

# table
jq -r --argjson n "$max_results_arg" '
  [limit($n; .[])]
  | .[]
  | [
      (.id // .ask_contract_id // "?"),
      (.machine_id // "?"),
      (.num_gpus // "?"),
      (.gpu_name // "?"),
      (.dph_total // "?"),
      (.dph_base // "?"),
      (.discounted_dph_total // "?"),
      (.reliability2 // .reliability // "?"),
      (.verification // "?"),
      (.geolocation // "?"),
      (.inet_down_cost // 0),
      (.inet_up_cost // 0)
    ]
  | @tsv
' <<<"$matches" | column -t -s $'\t' -N "id,machine_id,num_gpus,gpu,dph_total,dph_base,discounted_dph_total,reliability,verification,location,inet_down_cost,inet_up_cost"
