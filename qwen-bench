#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$ROOT_DIR/.qwen-vast/state.json"
KNOWN_HOSTS="$ROOT_DIR/.qwen-vast/known_hosts"
TUNNEL_LOG="$ROOT_DIR/.qwen-vast/tunnel.log"

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-lib.sh"

if [[ -f "$ROOT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
  set +a
fi

usage() {
  cat <<'USAGE'
Usage:
  ./qwen-bench [options]

Options:
  --label NAME          Human-readable benchmark label (default: coding-smoke)
  --prompt-file FILE    Use FILE as the user prompt instead of the built-in coding prompt
  --max-tokens N        Maximum generated tokens (default: 512)
  --timeout SECONDS     HTTP timeout (default: 900)
  --save-prompt         Copy the prompt into the local benchmark directory
  -h, --help            Show this help

Examples:
  ./qwen-bench
  ./qwen-bench --label code-review --prompt-file /tmp/repo-context.txt --max-tokens 1024

Each run is stored below .qwen-runs/<session>/benchmarks/. The benchmark uses
streaming to measure TTFT, while llama.cpp's final response timings provide
prompt/decode throughput and speculative draft acceptance.
USAGE
}

LABEL="coding-smoke"
PROMPT_FILE=""
MAX_TOKENS="${BENCH_MAX_TOKENS:-512}"
HTTP_TIMEOUT="${BENCH_TIMEOUT:-900}"
SAVE_PROMPT=0

while (( $# > 0 )); do
  case "$1" in
    --label)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --label requires a value"; exit 2; }
      LABEL="$2"; shift 2 ;;
    --prompt-file)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --prompt-file requires a file"; exit 2; }
      PROMPT_FILE="$2"; shift 2 ;;
    --max-tokens)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --max-tokens requires a value"; exit 2; }
      MAX_TOKENS="$2"; shift 2 ;;
    --timeout)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --timeout requires a value"; exit 2; }
      HTTP_TIMEOUT="$2"; shift 2 ;;
    --save-prompt)
      SAVE_PROMPT=1; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo >&2 "ERROR: unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

for cmd in vastai jq python3 ssh curl; do
  command -v "$cmd" >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: $cmd"; exit 2; }
done

[[ -f "$STATE_FILE" ]] || { echo >&2 "No local state. Run ./qwen-up first."; exit 2; }
# Recover an SSH endpoint/tunnel if qwen-up was interrupted after provisioning
# or the original tunnel died. This makes benchmark runs resumable.
if ! qwen_ensure_tunnel 0; then
  echo >&2 "ERROR: could not establish the local llama-server tunnel. Run ./qwen-status for details."
  exit 3
fi
[[ "$MAX_TOKENS" =~ ^[0-9]+$ ]] && (( MAX_TOKENS > 0 )) || { echo >&2 "ERROR: --max-tokens must be a positive integer"; exit 2; }
[[ "$HTTP_TIMEOUT" =~ ^[0-9]+$ ]] && (( HTTP_TIMEOUT > 0 )) || { echo >&2 "ERROR: --timeout must be a positive integer"; exit 2; }
if [[ -n "$PROMPT_FILE" && ! -f "$PROMPT_FILE" ]]; then
  echo >&2 "ERROR: prompt file not found: $PROMPT_FILE"
  exit 2
fi

local_port="$(jq -r '.local_port // 18080' "$STATE_FILE")"
api_key="$(jq -r '.api_key // empty' "$STATE_FILE")"
model="$(jq -r '.model // empty' "$STATE_FILE")"
run_dir="$(jq -r '.run_dir // empty' "$STATE_FILE")"
ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"
profile="$(jq -r '.profile // "unknown"' "$STATE_FILE")"
ctx_size="$(jq -r '.ctx_size // 0' "$STATE_FILE")"

[[ -n "$api_key" ]] || { echo >&2 "ERROR: no API key in state"; exit 2; }
[[ -n "$run_dir" ]] || { echo >&2 "ERROR: state predates telemetry support; start a new instance with ./qwen-up"; exit 2; }
mkdir -p "$run_dir/benchmarks"

safe_label="$(printf '%s' "$LABEL" | tr '[:space:]/' '--' | tr -cd '[:alnum:]_.-')"
[[ -n "$safe_label" ]] || safe_label="bench"
bench_id="$(date -u +%Y%m%dT%H%M%SZ)-${safe_label}"
bench_dir="$run_dir/benchmarks/$bench_id"
mkdir -p "$bench_dir"
chmod 700 "$bench_dir"

prompt_tmp=""
if [[ -n "$PROMPT_FILE" ]]; then
  prompt_source="$PROMPT_FILE"
else
  prompt_tmp="$(mktemp)"
  cat > "$prompt_tmp" <<'PROMPT'
You are reviewing a performance-sensitive Python service. Analyze the code below as if this were a real production code review. Identify correctness, concurrency, resource-management and performance problems, then propose a concrete refactor. Be precise and include revised code for the most important section.

```python
from concurrent.futures import ThreadPoolExecutor
import json
import sqlite3

executor = ThreadPoolExecutor(max_workers=32)
conn = sqlite3.connect("cache.db")

def analyze(paths, model):
    futures = []
    for path in paths:
        text = open(path).read()
        cached = conn.execute("select result from cache where path=?", (path,)).fetchone()
        if cached:
            return json.loads(cached[0])
        futures.append(executor.submit(model, text))

    results = [f.result() for f in futures]
    for path, result in zip(paths, results):
        conn.execute("insert into cache(path,result) values (?,?)", (path, json.dumps(result)))
    return results
```
PROMPT
  prompt_source="$prompt_tmp"
fi

cleanup() {
  [[ -n "${gpu_sampler_pid:-}" ]] && kill "$gpu_sampler_pid" >/dev/null 2>&1 || true
  [[ -n "${gpu_sampler_pid:-}" ]] && wait "$gpu_sampler_pid" >/dev/null 2>&1 || true
  [[ -n "$prompt_tmp" ]] && rm -f "$prompt_tmp"
}
trap cleanup EXIT INT TERM

if (( SAVE_PROMPT == 1 )); then
  cp "$prompt_source" "$bench_dir/prompt.txt"
  chmod 600 "$bench_dir/prompt.txt"
fi

# Capture a one-second GPU time series while the request is in flight. Failure
# is non-fatal because some Vast images/permissions may restrict nvidia-smi.
gpu_csv="$bench_dir/gpu.csv"
if [[ -n "$ssh_url" ]]; then
  read -r ssh_user ssh_host ssh_port < <(python3 - "$ssh_url" <<'PY'
from urllib.parse import urlparse
import sys
u = urlparse(sys.argv[1])
print(u.username or "root", u.hostname or "", u.port or 22)
PY
  )
  if [[ -n "$ssh_host" ]]; then
    qwen_ssh_sanitize_known_hosts "$ssh_host" "$ssh_port"
    {
      echo 'timestamp,index,name,utilization_gpu_pct,memory_used_mib,memory_total_mib,power_w,temperature_c'
      ssh \
        -o BatchMode=yes \
        -o ConnectTimeout=8 \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=3 \
        -o StrictHostKeyChecking=accept-new \
        -o "UserKnownHostsFile=$KNOWN_HOSTS" \
        -p "$ssh_port" \
        "${ssh_user}@${ssh_host}" \
        'while true; do nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu --format=csv,noheader,nounits 2>/dev/null || exit; sleep 1; done'
    } > "$gpu_csv" 2>/dev/null &
    gpu_sampler_pid=$!
  fi
fi

printf '[bench] session=%s profile=%s ctx=%s label=%s max_tokens=%s\n' \
  "$(basename "$run_dir")" "$profile" "$ctx_size" "$LABEL" "$MAX_TOKENS"

qwen_api_url=""
qwen_api_ca=""
IFS=$'\t' read -r qwen_api_url _ qwen_api_ca < <(qwen_api_urls)

python3 - \
  "$STATE_FILE" \
  "$prompt_source" \
  "$bench_dir" \
  "$LABEL" \
  "$MAX_TOKENS" \
  "$HTTP_TIMEOUT" \
  "$qwen_api_url" \
  "$qwen_api_ca" \
  "$api_key" \
  "$model" <<'PY'
from __future__ import annotations

import hashlib
import json
import pathlib
import ssl
import sys
import time
import urllib.error
import urllib.request

state_path, prompt_path, bench_dir_s, label, max_tokens_s, timeout_s, base_url, ca_path, api_key, model = sys.argv[1:]
bench_dir = pathlib.Path(bench_dir_s)
max_tokens = int(max_tokens_s)
timeout = int(timeout_s)
state = json.loads(pathlib.Path(state_path).read_text())
state_public = {k: v for k, v in state.items() if k not in {"api_key", "tunnel_pid"}}
prompt = pathlib.Path(prompt_path).read_text(errors="replace")
prompt_bytes = prompt.encode("utf-8")

ssl_context = None
if ca_path:
    ssl_context = ssl.create_default_context(cafile=ca_path)

headers = {
    "Authorization": f"Bearer {api_key}",
    "Content-Type": "application/json",
    "Accept": "text/event-stream",
}

def get_text(path: str) -> str | None:
    req = urllib.request.Request(base_url + path, headers={"Authorization": f"Bearer {api_key}"})
    try:
        with urllib.request.urlopen(req, timeout=10, context=ssl_context) as resp:
            return resp.read().decode("utf-8", "replace")
    except Exception:
        return None

def parse_prom(text: str | None) -> dict[str, float]:
    if not text:
        return {}
    # Some llama.cpp revisions accidentally returned the whole Prometheus body
    # as a JSON string. Normalize that form too.
    stripped = text.strip()
    if stripped.startswith('"'):
        try:
            parsed = json.loads(stripped)
            if isinstance(parsed, str):
                text = parsed
        except Exception:
            pass
    out: dict[str, float] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        name = parts[0].split("{", 1)[0]
        try:
            out[name] = float(parts[-1])
        except ValueError:
            pass
    return out

metrics_before_text = get_text("/metrics")
if metrics_before_text is not None:
    (bench_dir / "metrics-before.prom").write_text(metrics_before_text)
metrics_before = parse_prom(metrics_before_text)

payload = {
    "model": model,
    "messages": [{"role": "user", "content": prompt}],
    "max_tokens": max_tokens,
    "stream": True,
    "stream_options": {"include_usage": True},
    "cache_prompt": True,
}
body = json.dumps(payload).encode("utf-8")
req = urllib.request.Request(base_url + "/v1/chat/completions", data=body, headers=headers, method="POST")

started_wall = time.time()
t0 = time.perf_counter()
first_byte_s = None
first_token_s = None
content_parts: list[str] = []
reasoning_parts: list[str] = []
usage: dict = {}
timings: dict = {}
finish_reason = None
last_obj: dict = {}
error = None

try:
    with urllib.request.urlopen(req, timeout=timeout, context=ssl_context) as resp:
        first_byte_s = time.perf_counter() - t0
        for raw in resp:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if not data or data == "[DONE]":
                continue
            try:
                obj = json.loads(data)
            except json.JSONDecodeError:
                continue
            if not isinstance(obj, dict):
                continue
            last_obj = obj
            if isinstance(obj.get("usage"), dict):
                usage = obj["usage"]
            if isinstance(obj.get("timings"), dict):
                timings = obj["timings"]
            choices = obj.get("choices")
            if isinstance(choices, list) and choices and isinstance(choices[0], dict):
                choice = choices[0]
                if choice.get("finish_reason") is not None:
                    finish_reason = choice.get("finish_reason")
                delta = choice.get("delta")
                if isinstance(delta, dict):
                    emitted = False
                    content = delta.get("content")
                    if isinstance(content, str) and content:
                        content_parts.append(content)
                        emitted = True
                    reasoning = delta.get("reasoning_content")
                    if isinstance(reasoning, str) and reasoning:
                        reasoning_parts.append(reasoning)
                        emitted = True
                    # Some revisions use `reasoning` rather than
                    # `reasoning_content` in streamed deltas.
                    reasoning_alt = delta.get("reasoning")
                    if isinstance(reasoning_alt, str) and reasoning_alt:
                        reasoning_parts.append(reasoning_alt)
                        emitted = True
                    if emitted and first_token_s is None:
                        first_token_s = time.perf_counter() - t0
except urllib.error.HTTPError as exc:
    error = f"HTTP {exc.code}: {exc.read().decode('utf-8', 'replace')[:1000]}"
except Exception as exc:
    error = f"{type(exc).__name__}: {exc}"

total_s = time.perf_counter() - t0
ended_wall = time.time()

metrics_after_text = get_text("/metrics")
if metrics_after_text is not None:
    (bench_dir / "metrics-after.prom").write_text(metrics_after_text)
metrics_after = parse_prom(metrics_after_text)

def delta(name: str) -> float | None:
    if name not in metrics_before or name not in metrics_after:
        return None
    value = metrics_after[name] - metrics_before[name]
    return value if value >= 0 else None

metric_prompt_tokens = delta("llamacpp:prompt_tokens_total")
metric_prompt_seconds = delta("llamacpp:prompt_seconds_total")
metric_pred_tokens = delta("llamacpp:tokens_predicted_total")
metric_pred_seconds = delta("llamacpp:tokens_predicted_seconds_total")
metric_draft_tokens = delta("llamacpp:spec_decode_num_draft_tokens_total")
metric_draft_accepted = delta("llamacpp:spec_decode_num_accepted_tokens_total")
metric_draft_steps = delta("llamacpp:spec_decode_num_drafts_total")

prompt_tps_fallback = None
if metric_prompt_tokens is not None and metric_prompt_seconds and metric_prompt_seconds > 0:
    prompt_tps_fallback = metric_prompt_tokens / metric_prompt_seconds
pred_tps_fallback = None
if metric_pred_tokens is not None and metric_pred_seconds and metric_pred_seconds > 0:
    pred_tps_fallback = metric_pred_tokens / metric_pred_seconds

timing_cache_n = int(timings.get("cache_n") or 0)
timing_prompt_n = int(timings.get("prompt_n") or 0)
if usage.get("prompt_tokens") is not None:
    prompt_tokens = int(usage.get("prompt_tokens") or 0)
elif timing_cache_n or timing_prompt_n:
    prompt_tokens = timing_cache_n + timing_prompt_n
else:
    prompt_tokens = int(metric_prompt_tokens or 0)
completion_tokens = int(usage.get("completion_tokens") or timings.get("predicted_n") or metric_pred_tokens or 0)
cache_hit_rate = (timing_cache_n / prompt_tokens) if prompt_tokens > 0 and timing_cache_n >= 0 else None
prompt_tps = timings.get("prompt_per_second")
if not isinstance(prompt_tps, (int, float)):
    prompt_tps = prompt_tps_fallback
pred_tps = timings.get("predicted_per_second")
if not isinstance(pred_tps, (int, float)):
    pred_tps = pred_tps_fallback

draft_n = int(timings.get("draft_n") or metric_draft_tokens or 0)
draft_accepted = int(timings.get("draft_n_accepted") or metric_draft_accepted or 0)
accept_rate = (draft_accepted / draft_n) if draft_n > 0 else None

stream_decode_tps = None
if completion_tokens > 0 and first_token_s is not None and total_s > first_token_s:
    stream_decode_tps = completion_tokens / (total_s - first_token_s)

dph = float(state.get("dph") or 0)
request_cost = dph * total_s / 3600.0

result = {
    "schema_version": 1,
    "label": label,
    "ok": error is None,
    "error": error,
    "started_at_unix": started_wall,
    "ended_at_unix": ended_wall,
    "session": state_public,
    "request": {
        "prompt_sha256": hashlib.sha256(prompt_bytes).hexdigest(),
        "prompt_bytes": len(prompt_bytes),
        "prompt_chars": len(prompt),
        "max_tokens": max_tokens,
        "stream": True,
        "cache_prompt": True,
    },
    "usage": {
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "total_tokens": int(usage.get("total_tokens") or (prompt_tokens + completion_tokens)),
        "cached_tokens": ((usage.get("prompt_tokens_details") or {}).get("cached_tokens")
                          if isinstance(usage.get("prompt_tokens_details"), dict) else None),
    },
    "server_timings": timings,
    "performance": {
        "prompt_tps": prompt_tps,
        "decode_tps": pred_tps,
        "ttfb_s": first_byte_s,
        "ttft_s": first_token_s,
        "total_s": total_s,
        "stream_effective_decode_tps": stream_decode_tps,
        "draft_n": draft_n,
        "draft_n_accepted": draft_accepted,
        "draft_accept_rate": accept_rate,
        "request_compute_cost_usd": request_cost,
        "cache_n": timing_cache_n,
        "prompt_evaluated_n": timing_prompt_n,
        "cache_hit_rate": cache_hit_rate,
    },
    "metrics_delta": {
        "prompt_tokens": metric_prompt_tokens,
        "prompt_seconds": metric_prompt_seconds,
        "predicted_tokens": metric_pred_tokens,
        "predicted_seconds": metric_pred_seconds,
        "draft_tokens": metric_draft_tokens,
        "draft_accepted": metric_draft_accepted,
        "draft_verification_steps": metric_draft_steps,
        "prompt_tps": prompt_tps_fallback,
        "decode_tps": pred_tps_fallback,
    },
    "finish_reason": finish_reason,
}

(bench_dir / "response.txt").write_text("".join(content_parts))
(bench_dir / "reasoning.txt").write_text("".join(reasoning_parts))
(bench_dir / "response-final-chunk.json").write_text(json.dumps(last_obj, indent=2, ensure_ascii=False))
(bench_dir / "metrics.json").write_text(json.dumps(result, indent=2, ensure_ascii=False))

if error:
    print(f"ERROR: {error}", file=sys.stderr)
    raise SystemExit(1)

fmt = lambda v, n=2: "n/a" if v is None else f"{float(v):.{n}f}"
print(f"  prompt: {prompt_tokens} tok @ {fmt(prompt_tps)} t/s")
if timing_cache_n:
    print(f"  cache:  {timing_cache_n} tok reused ({fmt(100.0 * cache_hit_rate, 1)}%)")
else:
    print("  cache:  0 tok reused")
print(f"  decode: {completion_tokens} tok @ {fmt(pred_tps)} t/s")
print(f"  TTFT:   {fmt(first_token_s, 3)} s | total: {fmt(total_s, 3)} s")
if draft_n:
    print(f"  MTP:    {draft_accepted}/{draft_n} accepted ({fmt(100.0 * accept_rate, 1)}%)")
else:
    print("  MTP:    no draft counters in response")
print(f"  cost:   ${request_cost:.6f} compute for this request")
PY

# Stop sampling before summarizing it.
if [[ -n "${gpu_sampler_pid:-}" ]]; then
  kill "$gpu_sampler_pid" >/dev/null 2>&1 || true
  wait "$gpu_sampler_pid" >/dev/null 2>&1 || true
  gpu_sampler_pid=""
fi

# Keep a request-local tail as a fallback for MTP/timing stats and debugging.
server_tail="$bench_dir/server-tail.log"
if [[ -n "${ssh_host:-}" ]]; then
  ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=8 \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new \
    -o "UserKnownHostsFile=$KNOWN_HOSTS" \
    -p "$ssh_port" \
    "${ssh_user}@${ssh_host}" \
    'tail -n 300 /var/log/qwen38/server.log 2>/dev/null || true' \
    > "$server_tail" 2>/dev/null || true
fi

python3 - "$bench_dir/metrics.json" "$gpu_csv" "$server_tail" <<'PY'
import csv, json, pathlib, re, statistics, sys

metrics_path = pathlib.Path(sys.argv[1])
gpu_path = pathlib.Path(sys.argv[2])
server_tail_path = pathlib.Path(sys.argv[3])
data = json.loads(metrics_path.read_text())
rows = []
if gpu_path.exists():
    try:
        with gpu_path.open(newline="") as f:
            for row in csv.DictReader(f):
                try:
                    rows.append({
                        "util": float(row["utilization_gpu_pct"].strip()),
                        "mem": float(row["memory_used_mib"].strip()),
                        "mem_total": float(row["memory_total_mib"].strip()),
                        "power": float(row["power_w"].strip()),
                        "temp": float(row["temperature_c"].strip()),
                    })
                except (KeyError, ValueError):
                    pass
    except Exception:
        pass

if rows:
    data["gpu_summary"] = {
        "samples": len(rows),
        "avg_utilization_pct": statistics.mean(r["util"] for r in rows),
        "peak_utilization_pct": max(r["util"] for r in rows),
        "peak_memory_mib": max(r["mem"] for r in rows),
        "memory_total_mib": max(r["mem_total"] for r in rows),
        "avg_power_w": statistics.mean(r["power"] for r in rows),
        "peak_power_w": max(r["power"] for r in rows),
        "peak_temperature_c": max(r["temp"] for r in rows),
    }
else:
    data["gpu_summary"] = None

# Older/patched llama-server revisions may omit speculative counters from the
# OpenAI response while still printing them in the server log. Response timings
# remain authoritative; the log is only a fallback.
if server_tail_path.exists():
    text = server_tail_path.read_text(errors="replace")
    pp = re.findall(r"prompt eval time\s*=.*?([0-9]+(?:\.[0-9]+)?)\s+tokens per second", text)
    tg = re.findall(r"(?<!prompt )eval time\s*=.*?([0-9]+(?:\.[0-9]+)?)\s+tokens per second", text)
    drafts = re.findall(r"draft acceptance\s*=\s*([0-9.]+)\s*\(\s*(\d+) accepted\s*/\s*(\d+) generated", text)
    perf = data.setdefault("performance", {})
    if perf.get("prompt_tps") is None and pp:
        perf["prompt_tps"] = float(pp[-1])
        perf["prompt_tps_source"] = "server-log"
    if perf.get("decode_tps") is None and tg:
        perf["decode_tps"] = float(tg[-1])
        perf["decode_tps_source"] = "server-log"
    if not perf.get("draft_n") and drafts:
        ratio, accepted, generated = drafts[-1]
        perf["draft_n"] = int(generated)
        perf["draft_n_accepted"] = int(accepted)
        perf["draft_accept_rate"] = float(ratio)
        perf["draft_stats_source"] = "server-log"

metrics_path.write_text(json.dumps(data, indent=2, ensure_ascii=False))
PY

printf '[bench] saved: %s\n' "$bench_dir"
printf '[bench] compare all runs with: ./qwen-results\n'
