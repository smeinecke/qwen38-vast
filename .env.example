# Copy to .env. This file is gitignored.
# The model is currently publicly downloadable, so HF_TOKEN is optional.
HF_TOKEN=
HF_REVISION=993a5971fda8f30dd1b7eb2654792ba4415c7460

# Either set VAST_API_KEY here or authenticate once with:
#   vastai set api-key YOUR_KEY
VAST_API_KEY=

# Repository only, WITHOUT a tag. qwen-up appends the architecture image tag
# selected through profiles.json.
GHCR_IMAGE_BASE=ghcr.io/OWNER/REPO

# Default runtime profile. All profile definitions live in profiles.json.
# Included profiles (all definitions live in profiles.json):
#   4090-32k             -> RTX 4090 / SM89, budget 32k
#   a6000                -> RTX A6000 / SM86, 64k
#   ampere-value         -> cheapest RTX A6000 or A40 / SM86, 64k
#   a6000-128k / a6000-256k -> exact RTX A6000 / SM86
#   ampere-value-128k / -256k -> cheapest compatible RTX A6000 or A40 / SM86
#   ada-64k / ada-128k / ada-256k -> RTX 6000 Ada, L40/L40S/5880 Ada / SM89
#   5090-64k / 5090-128k -> exact RTX 5090 / SM120
#   blackwell-128k       -> RTX 5090 or RTX PRO 6000 / SM120
#   blackwell-256k       -> RTX PRO 6000 96 GB / SM120
QWEN_PROFILE=a6000

# Optional alternate profiles file.
QWEN_PROFILES_FILE=

# Model/runtime settings shared by all profiles.
MODEL=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf
USE_FASTMTP=1
REASONING_EFFORT=xhigh

# Optional one-off overrides. Leave empty for normal profile-driven operation.
CTX_SIZE_OVERRIDE=
GPU_QUERY_OVERRIDE=
GHCR_IMAGE_OVERRIDE=

# Optional emergency runtime SSH key. Normal CI builds bake your GitHub public
# SSH key into the image. If set, qwen-up additionally injects this public key
# at runtime; quote the whole OpenSSH line in .env.
# SSH_PUBLIC_KEY='ssh-ed25519 AAAA... user@host'
SSH_PUBLIC_KEY=

# Hard cost guard. qwen-up refuses offers above this all-in hourly price.
MAX_DPH=0.80
DISK_GB=100

# Vast traffic can cost more than the GPU during large image/model transfers.
# profiles.json defaults to rejecting any offer with non-zero download OR upload
# cost. Keep this at 0 for normal operation. Emergency escape hatch only:
QWEN_ALLOW_PAID_TRAFFIC=0

# Live Vast price monitor. It compares the running hourly rental $/h against same-context
# profiles and accepts only GPUs ranked equal-or-better in profiles.json's
# monitor_hardware.gpu_ranks. It alerts only when an available offer is at least
# this much cheaper. Start manually with `./qwen-monitor start`
# or set AUTO_START=1. qwen-down stops it automatically.
QWEN_MONITOR_THRESHOLD_PCT=10
QWEN_MONITOR_INTERVAL=180
QWEN_MONITOR_MAX_RESULTS=5
QWEN_MONITOR_AUTO_START=0
LOCAL_PORT=18080
# Automatically move to the next free localhost port if this one is occupied.
LOCAL_PORT_AUTO=1
START_TIMEOUT=1200

# If startup fails or qwen-up is interrupted, destroy the paid instance by
# default. Set to 1 only when you explicitly want to debug the failed host.
KEEP_ON_FAILURE=0

# Telemetry / benchmark history (local only, gitignored).
# QWEN_RUNS_DIR defaults to .qwen-runs next to the scripts.
QWEN_RUNS_DIR=
BENCH_MAX_TOKENS=512
BENCH_TIMEOUT=900

# Persistent llama.cpp slot/KV cache. qwen-up automatically downloads a
# compatible snapshot; qwen-down automatically saves and uploads slot 0 before
# destroying the Vast instance. Run ./qwen-cache-setup once first.
QWEN_SLOT_CACHE_ENABLED=1
QWEN_SLOT_CACHE_HOST=94.16.105.121
QWEN_SLOT_CACHE_PORT=22
QWEN_SLOT_CACHE_USER=qwen-cache
# Relative paths are relative to the cache user's home. 100 GB NVMe -> keep
# ~20 GB safety margin by pruning old session/signature snapshots above 80 GiB.
QWEN_SLOT_CACHE_ROOT=qwen-slot-cache
QWEN_SLOT_CACHE_MAX_GB=80
# Stable logical conversation/cache namespace. Change this if you want an
# independent persistent context instead of overwriting the same current slot.
QWEN_SLOT_CACHE_SESSION=default
# Dedicated private key generated by ./qwen-cache-setup. Never commit it.
QWEN_SLOT_CACHE_KEY=
# 0 = cache upload failure warns but qwen-down still stops billing.
# 1 = refuse to destroy the instance if the cache could not be uploaded.
QWEN_SLOT_CACHE_REQUIRE_SAVE=0
# Vast destroy calls are always non-interactive (-y) and bounded by this deadline.
# On timeout qwen-down keeps local state so the destroy can be retried safely.
QWEN_DESTROY_TIMEOUT_SECONDS=45

