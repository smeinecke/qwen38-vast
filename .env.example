# Copy to .env. This file is gitignored.
# The model is currently publicly downloadable, so HF_TOKEN is optional.
HF_TOKEN=
HF_REVISION=993a5971fda8f30dd1b7eb2654792ba4415c7460

# Either set VAST_API_KEY here or authenticate once with:
#   vastai set api-key YOUR_KEY
VAST_API_KEY=

# Repository only, WITHOUT a tag. qwen-up appends the stable tag selected by
# the profile: :a6000, :ada-128k, or :blackwell-128k.
GHCR_IMAGE_BASE=ghcr.io/OWNER/REPO

# Default profile when ./qwen-up is called without an argument.
# CLI examples:
#   ./qwen-up a6000
#   ./qwen-up ada-128k
#   ./qwen-up blackwell-128k
QWEN_PROFILE=a6000

# Model/runtime settings shared by all profiles.
MODEL=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf
USE_FASTMTP=1
REASONING_EFFORT=xhigh

# Profile defaults:
#   a6000          -> RTX A6000 / SM86,  65,536 context
#   ada-128k       -> Ada / SM89,       131,072 context
#   blackwell-128k -> RTX 5090/PRO 6000 / SM120, 131,072 context
#
# Optional one-off overrides. Leave empty for normal profile-driven operation.
CTX_SIZE_OVERRIDE=
GPU_QUERY_OVERRIDE=
GHCR_IMAGE_OVERRIDE=

# Hard cost guard. qwen-up refuses offers above this all-in hourly price.
MAX_DPH=0.80
DISK_GB=60
LOCAL_PORT=18080
START_TIMEOUT=1200

# If startup fails or qwen-up is interrupted, destroy the paid instance by
# default. Set to 1 only when you explicitly want to debug the failed host.
KEEP_ON_FAILURE=0

# Telemetry / benchmark history (local only, gitignored).
# QWEN_RUNS_DIR defaults to .qwen-runs next to the scripts.
QWEN_RUNS_DIR=
BENCH_MAX_TOKENS=512
BENCH_TIMEOUT=900
