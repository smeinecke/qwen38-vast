# Copy to .env. This file is gitignored.
# The model is currently publicly downloadable, so HF_TOKEN is optional.
HF_TOKEN=
HF_REVISION=993a5971fda8f30dd1b7eb2654792ba4415c7460

# Either set VAST_API_KEY here or authenticate once with:
#   vastai set api-key YOUR_KEY
VAST_API_KEY=

# Repository only, WITHOUT a tag. hostai up appends the architecture image tag
# selected through profiles.json.
GHCR_IMAGE_BASE=ghcr.io/OWNER/REPO

# Default runtime profile. All profile definitions live in profiles.json.
# Included profiles (all definitions live in profiles.json):
#   4090-32k             -> RTX 4090 / SM89, budget 32k
#   a6000                -> RTX A6000 / SM86, 64k
#   ampere-value         -> cheapest RTX A6000 or A40 / SM86, 64k
#   a6000-128k / a6000-256k -> exact RTX A6000 / SM86
#   ampere-value-128k / -256k -> cheapest compatible RTX A6000 or A40 / SM86
#   ada-64k / ada-128k / ada-256k -> RTX 6000 Ada, L40/L40S/5880 Ada / SM89
#   5090-64k / 5090-128k -> exact RTX 5090 / SM120
#   blackwell-128k       -> RTX 5090 or RTX PRO 6000 / SM120
#   blackwell-256k       -> RTX PRO 6000 96 GB / SM120
HOSTAI_PROFILE=a6000

# Optional alternate profiles file.
HOSTAI_PROFILES_FILE=

# Model/runtime settings shared by all profiles.
MODEL=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf
USE_FASTMTP=1
REASONING_EFFORT=xhigh

# Optional llama-server KV cache type (e.g. q4_0, f16). Leave empty for default.
CACHE_TYPE_K=
CACHE_TYPE_V=

# Optional one-off overrides. Leave empty for normal profile-driven operation.
CTX_SIZE_OVERRIDE=
GPU_QUERY_OVERRIDE=
GHCR_IMAGE_OVERRIDE=

# llama-server host prompt cache size in MiB (default 8192). For 128k/256k
# context the prompt state can exceed 8 GB; set CACHE_RAM=0 to disable, or
# e.g. 24576 to cache up to 24 GB of host RAM. CTX_CHECKPOINTS=0 disables
# context checkpoints if you see unbounded host memory growth.
CACHE_RAM=
CTX_CHECKPOINTS=

# Optional emergency runtime SSH key. Normal CI builds bake your GitHub public
# SSH key into the image. If set, hostai up additionally injects this public key
# at runtime; quote the whole OpenSSH line in .env.
# SSH_PUBLIC_KEY='ssh-ed25519 AAAA... user@host'
SSH_PUBLIC_KEY=

# Optional Vast persistent volume for the model files. This makes the GGUF
# files and Hugging Face cache survive container recycles. Create a volume on
# the Vast Storage page first, then set HOSTAI_VOLUME_MOUNT_PATH=/models.
HOSTAI_VOLUME_ID=
HOSTAI_VOLUME_MOUNT_PATH=

# Hard cost guard. hostai up refuses offers above this all-in hourly price.
MAX_DPH=0.80
DISK_GB=100

# Vast traffic can cost more than the GPU during large image/model transfers.
# profiles.json defaults to rejecting any offer with non-zero download OR upload
# cost. Set these to 0 to enforce free traffic, or raise them to allow paid
# traffic up to a specific price. Vast reports inet_down_cost and inet_up_cost
# as $/GB.
HOSTAI_MAX_INET_DOWN_COST=0.001
HOSTAI_MAX_INET_UP_COST=0.001

# Set to 1 for legacy TCP/on-disk behavior. Default is secure: Unix socket on
# the remote, TLS inside the SSH tunnel, and all logs/keys on tmpfs only.
HOSTAI_UNSECURE=0

# Client-side tokenization. If 1, the remote llama-server is wrapped by a guard
# that only accepts tokenized prompts, and hostai proxy tokenizes locally before
# forwarding. The OpenAI-compatible endpoint for clients becomes the proxy socket.
HOSTAI_TOKENIZED_ONLY=0
# Local Unix socket path for hostai proxy (empty means .hostai-vast/proxy.sock).
HOSTAI_PROXY_SOCKET=
# Optional local TCP port for clients that cannot use a Unix socket.
HOSTAI_PROXY_PORT=0
# Hugging Face model ID used to download the tokenizer. The Qwen3.8-27B base
# model ships the tokenizer files; the weights are not downloaded.
HOSTAI_PROXY_TOKENIZER_MODEL=Qwen/Qwen3.8-27B
# Pinned model revision (commit SHA) for the tokenizer files. This makes
# tokenization reproducible and is verified by golden tests.
HOSTAI_PROXY_TOKENIZER_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
# Cache directory for the downloaded tokenizer (empty means .hostai-cache/tokenizer).
HOSTAI_PROXY_CACHE_DIR=

# Live Vast price monitor. It compares the running hourly rental $/h against same-context
# profiles and accepts only GPUs ranked equal-or-better in profiles.json's
# monitor_hardware.gpu_ranks. It alerts only when an available offer is at least
# this much cheaper. Start manually with `hostai monitor start`
# or set AUTO_START=1. hostai down stops it automatically.
HOSTAI_MONITOR_THRESHOLD_PCT=10
HOSTAI_MONITOR_INTERVAL=180
HOSTAI_MONITOR_MAX_RESULTS=5
HOSTAI_MONITOR_AUTO_START=0
LOCAL_PORT=18080
# Automatically move to the next free localhost port if this one is occupied.
LOCAL_PORT_AUTO=1
START_TIMEOUT=1200

# If startup fails or hostai up is interrupted, destroy the paid instance by
# default. Set to 1 only when you explicitly want to debug the failed host.
KEEP_ON_FAILURE=0

# Telemetry / benchmark history (local only, gitignored).
# HOSTAI_RUNS_DIR defaults to .hostai-runs next to the scripts.
HOSTAI_RUNS_DIR=
BENCH_MAX_TOKENS=512
BENCH_TIMEOUT=900

# Persistent llama.cpp slot/KV cache. hostai up automatically downloads a
# compatible snapshot; hostai down automatically saves and uploads slot 0 before
# destroying the Vast instance.
HOSTAI_SLOT_CACHE_ENABLED=1

# --- SSH/rsync backend (default) ---
# Run hostai cache setup once first to prepare the cache key.
# Set this to your own cache server (IP or hostname).
HOSTAI_SLOT_CACHE_HOST=your-cache-server.example.com
HOSTAI_SLOT_CACHE_PORT=22
HOSTAI_SLOT_CACHE_USER=qwen-cache
# Dedicated private key generated by hostai cache setup. Never commit it.
HOSTAI_SLOT_CACHE_KEY=

# --- rclone backend (alternative) ---
# Set to 1 to use rclone instead of SSH/rsync. When enabled, host/port/key
# above are ignored and rclone is used to push/pull the slot snapshot.
HOSTAI_SLOT_CACHE_RCLONE=0
# Name of a preconfigured rclone remote. When set, type/url/user/pass are ignored.
HOSTAI_SLOT_CACHE_RCLONE_REMOTE=
# Backend type (e.g. webdav, s3, sftp). Defaults to webdav.
HOSTAI_SLOT_CACHE_RCLONE_TYPE=webdav
# Base URL for the backend. Example for WebDAV:
# HOSTAI_SLOT_CACHE_RCLONE_URL=https://your-cache-server.example.com/
HOSTAI_SLOT_CACHE_RCLONE_URL=
# Backend user. Defaults to HOSTAI_SLOT_CACHE_USER if not set.
HOSTAI_SLOT_CACHE_RCLONE_USER=
# Backend password. rclone obscures it on the remote host.
HOSTAI_SLOT_CACHE_RCLONE_PASSWORD=

# Relative paths are relative to the cache user's home. 100 GB NVMe -> keep
# ~20 GB safety margin by pruning old session/signature snapshots above 80 GiB.
HOSTAI_SLOT_CACHE_ROOT=qwen-slot-cache
HOSTAI_SLOT_CACHE_MAX_GB=80
# Stable logical conversation/cache namespace. Change this if you want an
# independent persistent context instead of overwriting the same current slot.
HOSTAI_SLOT_CACHE_SESSION=default
# 0 = cache upload failure warns but hostai down still stops billing.
# 1 = refuse to destroy the instance if the cache could not be uploaded.
HOSTAI_SLOT_CACHE_REQUIRE_SAVE=0

# If 1, stage the slot snapshot under /dev/shm instead of on Vast disk.
# This keeps current.bin (prompt/KV state) out of the instance NVMe. When /dev/shm
# is too small hostai up warns and disables the slot cache for that host, unless
# HOSTAI_SLOT_CACHE_SHM_REQUIRE is 1 or you pass --abort-if-shm-too-small.
HOSTAI_SLOT_CACHE_USE_SHM=0

# Optional explicit local staging path. Empty means /dev/shm/qwen38/slots when
# HOSTAI_SLOT_CACHE_USE_SHM=1, otherwise /var/lib/qwen38/slots.
HOSTAI_SLOT_CACHE_LOCAL_DIR=

# Minimum free /dev/shm space in GiB to allow the slot cache. 0 disables the
# explicit check; the preflight still compares against the remote snapshot size
# if a saved current.bin already exists.
HOSTAI_SHM_MIN_GB=0

# If 1, hostai up aborts instead of warning/disabling the slot cache when
# /dev/shm is too small. Use the --abort-if-shm-too-small CLI flag for one-offs.
HOSTAI_SLOT_CACHE_SHM_REQUIRE=0

# Requested Docker --shm-size in GiB for the Vast container. Vast support is
# uncertain; the runtime preflight is the real guard. Leave empty to rely on
# Vast's automatic shared memory sizing.
HOSTAI_SHM_SIZE_GB=

# Vast destroy calls are always non-interactive (-y) and bounded by this deadline.
# On timeout hostai down keeps local state so the destroy can be retried safely.
HOSTAI_DESTROY_TIMEOUT_SECONDS=45

