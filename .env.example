# Copy to .env. This file is gitignored.
# You must accept the model's Hugging Face access conditions first.
HF_TOKEN=hf_replace_me
HF_REVISION=993a5971fda8f30dd1b7eb2654792ba4415c7460

# Either set VAST_API_KEY here or authenticate once with:
#   vastai set api-key YOUR_KEY
VAST_API_KEY=

# Change OWNER/REPO after pushing this repository to GitHub and making the
# generated GHCR package public.
GHCR_IMAGE=ghcr.io/OWNER/REPO:latest

# Q4 is the default for a 48 GB card with ~245k context.
MODEL=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf
CTX_SIZE=245760
USE_FASTMTP=1
REASONING_EFFORT=xhigh

# Search only performant 48 GB cards by default. RTX_A6000 is slower but can
# be very cheap. Edit this query if you want a specific GPU or region.
GPU_QUERY='num_gpus=1 gpu_name in ["RTX_6000Ada","L40S","RTX_A6000"] gpu_ram>=48 cpu_ram>=64000 reliability>0.98 inet_down>=500 cuda_vers>=12.8 disk_space>=60 rented=False direct_port_count>=1'

# Hard cost guard. qwen-up will refuse offers above this all-in hourly price.
MAX_DPH=0.80
DISK_GB=60
LOCAL_PORT=18080
START_TIMEOUT=1200

# If startup fails or qwen-up is interrupted, destroy the paid instance by
# default. Set to 1 only when you explicitly want to debug the failed host.
KEEP_ON_FAILURE=0
