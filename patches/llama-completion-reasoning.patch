+            msg.role = "user";
+            msg.content = "";
+            chat_inputs.messages = { msg };
+            chat_inputs.add_generation_prompt = true;
+            chat_inputs.use_jinja = meta->chat_params.use_jinja;
+            chat_inputs.enable_thinking = meta->chat_params.enable_thinking;
+            chat_inputs.reasoning_format = meta->chat_params.reasoning_format;
+            chat_inputs.chat_template_kwargs = meta->chat_params.chat_template_kwargs;
+            if (data.contains("reasoning_format")) {
+                chat_inputs.reasoning_format = common_reasoning_format_from_name(data.at("reasoning_format").get<std::string>());
+            }
+            const auto chat_params = common_chat_templates_apply(meta->chat_params.tmpls.get(), chat_inputs);
+            if (chat_params.format != COMMON_CHAT_FORMAT_CONTENT_ONLY) {
+                data["chat_format"] = static_cast<int>(chat_params.format);
+                if (!chat_params.parser.empty()) {
+                    data["chat_parser"] = chat_params.parser;
+                }
+                if (!chat_params.generation_prompt.empty()) {
+                    data["generation_prompt"] = chat_params.generation_prompt;
+                }
+            }
+        }
+
         const auto & prompt = data.at("prompt");
