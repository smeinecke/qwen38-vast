     try {
         std::vector<server_task> tasks;
 
+        // For /completion with a tokenized prompt, the request body does not
+        // carry the chat parser that oaicompat_chat_params_parse would inject.
+        // Build it from the model template so reasoning can be parsed out.
+        if (type == SERVER_TASK_TYPE_COMPLETION && json_is_array_and_contains_numbers(data.at("prompt")) && !data.contains("chat_format")) {
+            common_chat_templates_inputs chat_inputs;
