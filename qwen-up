#!/usr/bin/env bash
set -Eeuo pipefail

# Vast returns decimal numbers with a dot. Force locale-independent numeric
# parsing/printf so German locales do not turn 0.4167 into an invalid number.
export LC_NUMERIC=C

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT_DIR/.qwen-vast"
STATE_FILE="$STATE_DIR/state.json"
ENV_FILE="$STATE_DIR/env"
KNOWN_HOSTS="$STATE_DIR/known_hosts"
TUNNEL_LOG="$STATE_DIR/tunnel.log"

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-lib.sh"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

if [[ -f "$ROOT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
  set +a
fi

RUNS_DIR="${QWEN_RUNS_DIR:-$ROOT_DIR/.qwen-runs}"
PROFILES_FILE="${QWEN_PROFILES_FILE:-$ROOT_DIR/profiles.json}"

usage() {
  cat <<'USAGE'
Usage:
  ./qwen-up [PROFILE]
  ./qwen-up --profile PROFILE

Profiles are defined in profiles.json. Edit that file to change GPU queries,
context defaults or profile aliases without touching qwen-up.
USAGE
  if command -v jq >/dev/null 2>&1 && [[ -f "$PROFILES_FILE" ]]; then
    jq -r '
      .profiles[] |
      "  \(.name)\tctx=\(.ctx_size)\timage=\(.image)" +
      (if ((.aliases // []) | length) > 0 then "\taliases=" + ((.aliases // []) | join(",")) else "" end)
    ' "$PROFILES_FILE" 2>/dev/null || true
  fi
  cat <<'USAGE'

Examples:
  ./qwen-up a6000
  ./qwen-up a6000-128k
  ./qwen-up blackwell-128k
  CTX_SIZE_OVERRIDE=98304 ./qwen-up a6000

Use *_OVERRIDE variables only for intentional one-off tests.
USAGE
}

profile_arg=""
case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  -p|--profile)
    [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --profile requires a value"; exit 2; }
    profile_arg="$2"
    shift 2
    ;;
  "")
    ;;
  -*)
    echo >&2 "ERROR: unknown option: $1"
    usage >&2
    exit 2
    ;;
  *)
    profile_arg="$1"
    shift
    ;;
esac

if (( $# > 0 )); then
  echo >&2 "ERROR: unexpected argument: $1"
  usage >&2
  exit 2
fi

command -v jq >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: jq"; exit 2; }
[[ -f "$PROFILES_FILE" ]] || { echo >&2 "ERROR: profiles file not found: $PROFILES_FILE"; exit 2; }
jq -e '.schema_version == 1 and (.images|type=="array") and (.profiles|type=="array")' "$PROFILES_FILE" >/dev/null \
  || { echo >&2 "ERROR: invalid profiles file: $PROFILES_FILE"; exit 2; }

DEFAULT_PROFILE="$(jq -r '.default_profile // "a6000"' "$PROFILES_FILE")"
PROFILE_INPUT="${profile_arg:-${QWEN_PROFILE:-$DEFAULT_PROFILE}}"
PROFILE_JSON="$(jq -c --arg p "$PROFILE_INPUT" '
  [.profiles[] | select(.name == $p or (((.aliases // []) | index($p)) != null))][0] // empty
' "$PROFILES_FILE")"
if [[ -z "$PROFILE_JSON" || "$PROFILE_JSON" == "null" ]]; then
  echo >&2 "ERROR: unknown profile '$PROFILE_INPUT'"
  usage >&2
  exit 2
fi

PROFILE="$(jq -r '.name' <<<"$PROFILE_JSON")"
IMAGE_NAME="$(jq -r '.image' <<<"$PROFILE_JSON")"
PROFILE_CTX_SIZE="$(jq -r '.ctx_size' <<<"$PROFILE_JSON")"
PROFILE_GPU_QUERY="$(jq -r '.gpu_query' <<<"$PROFILE_JSON")"
IMAGE_JSON="$(jq -c --arg image "$IMAGE_NAME" '[.images[] | select(.name == $image)][0] // empty' "$PROFILES_FILE")"
if [[ -z "$IMAGE_JSON" || "$IMAGE_JSON" == "null" ]]; then
  echo >&2 "ERROR: profile '$PROFILE' references unknown image '$IMAGE_NAME'"
  exit 2
fi
IMAGE_TAG="$(jq -r '.image_tag' <<<"$IMAGE_JSON")"
CUDA_ARCH="$(jq -r '.cuda_arch' <<<"$IMAGE_JSON")"

# Migration guard: older revisions used CTX_SIZE/GPU_QUERY directly in .env.
# Ignore them here so choosing a profile on the CLI always does what it says.
# Explicit *_OVERRIDE values are still available for one-off experiments.
if [[ -n "${CTX_SIZE:-}" ]]; then
  echo >&2 "[config] note: legacy CTX_SIZE is ignored; use CTX_SIZE_OVERRIDE instead."
fi
if [[ -n "${GPU_QUERY:-}" ]]; then
  echo >&2 "[config] note: legacy GPU_QUERY is ignored; use GPU_QUERY_OVERRIDE instead."
fi

CTX_SIZE="${CTX_SIZE_OVERRIDE:-$PROFILE_CTX_SIZE}"
GPU_QUERY="${GPU_QUERY_OVERRIDE:-$PROFILE_GPU_QUERY}"
MAX_DPH="${MAX_DPH:-0.80}"
DISK_GB="${DISK_GB:-60}"
LOCAL_PORT="${LOCAL_PORT:-18080}"
START_TIMEOUT="${START_TIMEOUT:-1200}"
KEEP_ON_FAILURE="${KEEP_ON_FAILURE:-0}"
MODEL="${MODEL:-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf}"
USE_FASTMTP="${USE_FASTMTP:-1}"
REASONING_EFFORT="${REASONING_EFFORT:-xhigh}"
HF_REVISION="${HF_REVISION:-993a5971fda8f30dd1b7eb2654792ba4415c7460}"
LABEL="${VAST_LABEL:-qwen38-${PROFILE}-$(date +%s)}"

# Prefer the new repository-only setting. For compatibility, an old
# GHCR_IMAGE=...:latest value is accepted as a source for the repository name;
# its old tag is deliberately replaced by the selected stable profile tag.
if [[ -n "${GHCR_IMAGE_BASE:-}" ]]; then
  image_base="${GHCR_IMAGE_BASE%/}"
elif [[ -n "${GHCR_IMAGE:-}" && "$GHCR_IMAGE" != *"OWNER/REPO"* ]]; then
  image_base="${GHCR_IMAGE%:*}"
else
  image_base=""
fi

if [[ -z "$image_base" || "$image_base" == *"OWNER/REPO"* ]]; then
  echo >&2 "ERROR: set GHCR_IMAGE_BASE in .env, e.g. ghcr.io/yourname/qwen38-vast"
  exit 2
fi

SELECTED_IMAGE="${GHCR_IMAGE_OVERRIDE:-${image_base}:${IMAGE_TAG}}"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "ERROR: missing dependency: $1"
    exit 2
  }
}

for cmd in vastai jq curl ssh python3 openssl; do need "$cmd"; done

if [[ -f "$STATE_FILE" ]]; then
  old_id="$(jq -r '.instance_id // empty' "$STATE_FILE" 2>/dev/null || true)"
  if [[ -n "$old_id" ]]; then
    if old_json="$(vastai show instance "$old_id" --raw 2>/dev/null)"; then
      old_status="$(jq -r '.actual_status // .status // "unknown"' <<<"$old_json" 2>/dev/null || echo unknown)"
      if [[ "$old_status" != "exited" && "$old_status" != "offline" ]]; then
        echo >&2 "ERROR: state file already references Vast instance $old_id ($old_status)."
        echo >&2 "Run ./qwen-status or ./qwen-down first."
        exit 3
      fi
    fi
  fi
  rm -f "$STATE_FILE" "$ENV_FILE" "$TUNNEL_LOG" "$KNOWN_HOSTS"
fi

if python3 - "$LOCAL_PORT" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket()
try:
    s.bind(("127.0.0.1", port))
except OSError:
    raise SystemExit(1)
finally:
    s.close()
PY
then
  :
else
  echo >&2 "ERROR: local port $LOCAL_PORT is already in use. Change LOCAL_PORT in .env."
  exit 2
fi

MODEL_API_KEY="${MODEL_API_KEY:-sk-local-$(openssl rand -hex 24)}"
instance_id=""
tunnel_pid=""
ready=0

RUN_ID="${QWEN_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-${PROFILE}-$$}"
RUN_DIR="$RUNS_DIR/$RUN_ID"
RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
RUN_STARTED_EPOCH="$(date +%s)"
mkdir -p "$RUN_DIR"
chmod 700 "$RUNS_DIR" "$RUN_DIR" 2>/dev/null || true
CLIENT_LOG="$RUN_DIR/client.log"

# Keep a local copy of qwen-up's output. The run directory is separate from
# .qwen-vast so shutdown can remove transient state without losing history.
exec > >(tee -a "$CLIENT_LOG") 2> >(tee -a "$CLIENT_LOG" >&2)

jq -n \
  --arg run_id "$RUN_ID" \
  --arg status "searching" \
  --arg started_at "$RUN_STARTED_AT" \
  --arg profile "$PROFILE" \
  --arg cuda_arch "$CUDA_ARCH" \
  --arg image "$SELECTED_IMAGE" \
  --argjson ctx_size "$CTX_SIZE" \
  --arg model "$MODEL" \
  --argjson fastmtp "$USE_FASTMTP" \
  '{schema_version:1,run_id:$run_id,status:$status,started_at:$started_at,profile:$profile,cuda_arch:$cuda_arch,image:$image,ctx_size:$ctx_size,model:$model,use_fastmtp:$fastmtp}' \
  > "$RUN_DIR/metadata.json"
chmod 600 "$RUN_DIR/metadata.json"

sync_run_metadata() {
  local status="$1"
  [[ -f "$STATE_FILE" ]] || return 0
  local updated_at
  updated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  jq --arg status "$status" --arg updated_at "$updated_at" \
    'del(.api_key,.tunnel_pid) + {status:$status,metadata_updated_at:$updated_at}' \
    "$STATE_FILE" > "$RUN_DIR/metadata.json.tmp" && \
    mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json"
  chmod 600 "$RUN_DIR/metadata.json"
}

cleanup_paid_instance() {
  local reason="$1"
  [[ -n "$tunnel_pid" ]] && kill "$tunnel_pid" >/dev/null 2>&1 || true
  if [[ -f "$STATE_FILE" ]]; then
    jq --arg reason "$reason" --arg ended_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '. + {failure_reason:$reason,ended_at:$ended_at}' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
    sync_run_metadata "failed" || true
  else
    jq --arg reason "$reason" --arg ended_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '. + {status:"failed",failure_reason:$reason,ended_at:$ended_at}' "$RUN_DIR/metadata.json" > "$RUN_DIR/metadata.json.tmp" 2>/dev/null && mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json" || true
  fi
  if [[ -n "$instance_id" && "$KEEP_ON_FAILURE" != "1" ]]; then
    echo >&2 "[cleanup] $reason; destroying Vast instance $instance_id to stop billing..."
    vastai destroy instance "$instance_id" --raw >/dev/null 2>&1 || true
    rm -f "$STATE_FILE" "$ENV_FILE"
  elif [[ -n "$instance_id" ]]; then
    echo >&2 "[cleanup] $reason; KEEP_ON_FAILURE=1, leaving instance $instance_id running."
  fi
}

on_signal() {
  cleanup_paid_instance "interrupted"
  exit 130
}
trap on_signal INT TERM

printf '[profile] %s | sm_%s | ctx=%s | image=%s\n' "$PROFILE" "$CUDA_ARCH" "$CTX_SIZE" "$SELECTED_IMAGE"
printf '[search] %s\n' "$GPU_QUERY"
offers_raw="$(vastai search offers "$GPU_QUERY" --order dph_total --limit 25 --storage "$DISK_GB" --raw)"

offers="$(jq -c '
  if type == "array" then .
  elif (.offers? | type) == "array" then .offers
  elif .offers? then [.offers]
  elif (.bundles? | type) == "array" then .bundles
  else [] end
' <<<"$offers_raw")"

offer="$(jq -c --argjson max "$MAX_DPH" '
  [ .[]
    | ._effective_dph = (.dph_total // .dph_base // 999999)
    | select(._effective_dph <= $max)
  ]
  | sort_by(._effective_dph)
  | .[0] // empty
' <<<"$offers")"

if [[ -z "$offer" || "$offer" == "null" ]]; then
  echo >&2 "ERROR: no matching offer at or below \$$MAX_DPH/h."
  echo >&2 "Raise MAX_DPH or set GPU_QUERY_OVERRIDE for this test."
  exit 4
fi

offer_id="$(jq -r '.id // .ask_contract_id // empty' <<<"$offer")"
gpu_name="$(jq -r '.gpu_name // "unknown"' <<<"$offer")"
dph="$(jq -r '._effective_dph' <<<"$offer")"
inet_down="$(jq -r '.inet_down // "?"' <<<"$offer")"
disk_bw="$(jq -r '.disk_bw // "?"' <<<"$offer")"
reliability="$(jq -r '.reliability2 // .reliability // "?"' <<<"$offer")"
location="$(jq -r '.geolocation // "?"' <<<"$offer")"

if [[ -z "$offer_id" ]]; then
  echo >&2 "ERROR: could not read offer ID from Vast response."
  exit 4
fi

printf '[rent] %s | $%.4f/h | down=%s Mbps | disk=%s MB/s | reliability=%s | %s | offer=%s\n' \
  "$gpu_name" "$dph" "$inet_down" "$disk_bw" "$reliability" "$location" "$offer_id"

# v7 uses Vast's normal entrypoint/args launch mode. Port 22 is a normal
# Docker mapping and sshd is part of our image; Vast no longer injects a child
# /ssh image or rewrites authorized_keys at paid-instance startup.
docker_env="-p 22:22 -e QWEN_PROFILE=${PROFILE} -e LLAMA_API_KEY=${MODEL_API_KEY} -e MODEL=${MODEL} -e CTX_SIZE=${CTX_SIZE} -e USE_FASTMTP=${USE_FASTMTP} -e REASONING_EFFORT=${REASONING_EFFORT} -e HF_REVISION=${HF_REVISION} -e BIND_HOST=127.0.0.1"
if [[ -n "${HF_TOKEN:-}" ]]; then
  docker_env+=" -e HF_TOKEN=${HF_TOKEN}"
fi
# Optional local emergency key override; normal images already contain the key
# prepared by GitHub Actions. Encoding avoids spaces breaking Docker -e syntax.
if [[ -n "${SSH_PUBLIC_KEY:-}" ]]; then
  ssh_public_key_b64="$(python3 - <<'PYKEY'
import base64, os
print(base64.b64encode(os.environ["SSH_PUBLIC_KEY"].encode()).decode())
PYKEY
)"
  docker_env+=" -e QWEN_SSH_PUBLIC_KEY_B64=${ssh_public_key_b64}"
fi

create_raw="$(vastai create instance "$offer_id" \
  --image "$SELECTED_IMAGE" \
  --disk "$DISK_GB" \
  --label "$LABEL" \
  --env "$docker_env" \
  --raw \
  --args qwen38)" || {
    echo >&2 "ERROR: Vast failed to create the instance."
    exit 5
  }

instance_id="$(jq -r '.new_contract // .instance_id // .id // empty' <<<"$create_raw")"
if [[ -z "$instance_id" ]]; then
  echo >&2 "ERROR: Vast create response did not contain an instance ID:"
  echo >&2 "$create_raw"
  exit 5
fi

INSTANCE_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
INSTANCE_STARTED_EPOCH="$(date +%s)"

jq -n \
  --argjson instance_id "$instance_id" \
  --arg offer_id "$offer_id" \
  --arg gpu "$gpu_name" \
  --argjson dph "$dph" \
  --argjson local_port "$LOCAL_PORT" \
  --arg model "$MODEL" \
  --argjson ctx "$CTX_SIZE" \
  --arg api_key "$MODEL_API_KEY" \
  --arg image "$SELECTED_IMAGE" \
  --arg label "$LABEL" \
  --arg profile "$PROFILE" \
  --arg cuda_arch "$CUDA_ARCH" \
  --arg run_id "$RUN_ID" \
  --arg run_dir "$RUN_DIR" \
  --arg started_at "$INSTANCE_STARTED_AT" \
  --argjson started_epoch "$INSTANCE_STARTED_EPOCH" \
  --arg run_started_at "$RUN_STARTED_AT" \
  --argjson run_started_epoch "$RUN_STARTED_EPOCH" \
  --arg location "$location" \
  --arg inet_down "$inet_down" \
  --arg disk_bw "$disk_bw" \
  --arg reliability "$reliability" \
  --argjson fastmtp "$USE_FASTMTP" \
  --arg reasoning_effort "$REASONING_EFFORT" \
  '{schema_version:1,instance_id:$instance_id,offer_id:$offer_id,gpu:$gpu,dph:$dph,local_port:$local_port,model:$model,ctx_size:$ctx,api_key:$api_key,image:$image,label:$label,profile:$profile,cuda_arch:$cuda_arch,run_id:$run_id,run_dir:$run_dir,started_at:$started_at,started_epoch:$started_epoch,run_started_at:$run_started_at,run_started_epoch:$run_started_epoch,location:$location,inet_down:$inet_down,disk_bw:$disk_bw,reliability:$reliability,use_fastmtp:$fastmtp,reasoning_effort:$reasoning_effort}' \
  > "$STATE_FILE"
chmod 600 "$STATE_FILE"
sync_run_metadata "provisioning"

echo "[boot] Vast instance $instance_id created; waiting for mapped SSH port..."
start_epoch="$(date +%s)"
ssh_url=""
ssh_user=""
ssh_host=""
ssh_port=""
last_boot_log=0
while :; do
  now="$(date +%s)"
  if (( now - start_epoch > START_TIMEOUT )); then
    cleanup_paid_instance "startup timeout while waiting for SSH"
    exit 6
  fi

  instance_json="$(vastai show instance "$instance_id" --raw 2>/dev/null || true)"
  status="$(jq -r '.actual_status // .status // "loading"' <<<"${instance_json:-{}}" 2>/dev/null || echo loading)"
  case "$status" in
    exited|unknown|offline)
      cleanup_paid_instance "instance entered status '$status'"
      exit 6
      ;;
  esac

  endpoint="$(qwen_resolve_ssh_endpoint "$instance_id" "$instance_json" 2>/dev/null || true)"
  if [[ -n "$endpoint" ]]; then
    IFS=$'\t' read -r ssh_user ssh_host ssh_port ssh_url <<<"$endpoint"
    if [[ -n "$ssh_host" && "$ssh_port" =~ ^[0-9]+$ ]]; then
      jq --arg ssh_url "$ssh_url" --arg ssh_host "$ssh_host" --arg ssh_user "$ssh_user" --argjson ssh_port "$ssh_port" \
        '. + {ssh_url:$ssh_url,ssh_host:$ssh_host,ssh_port:$ssh_port,ssh_user:$ssh_user}' \
        "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      chmod 600 "$STATE_FILE"
      break
    fi
  fi

  if (( now - last_boot_log >= 15 )); then
    last_boot_log="$now"
    published_host="$(jq -r '.public_ipaddr // .public_ip // .ssh_host // empty' <<<"${instance_json:-{}}" 2>/dev/null || true)"
    published_port="$(jq -r '.ports["22/tcp"][0].HostPort // .ssh_port // empty' <<<"${instance_json:-{}}" 2>/dev/null || true)"
    if [[ -n "$published_host" || -n "$published_port" ]]; then
      printf '[boot] status=%s | ssh=%s:%s | waiting for complete endpoint...\n' "$status" "${published_host:-?}" "${published_port:-?}"
    else
      printf '[boot] status=%s | port 22 mapping not published yet...\n' "$status"
    fi
  fi
  sleep 5
done

mapfile -d '' -t ssh_opts < <(qwen_ssh_opts "$ssh_port")
echo "[ssh] endpoint discovered: ${ssh_user}@${ssh_host}:${ssh_port}; waiting for SSH daemon..."
last_ssh_log=0
while ! ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" true >/dev/null 2>&1; do
  now="$(date +%s)"
  if (( now - start_epoch > START_TIMEOUT )); then
    cleanup_paid_instance "startup timeout while waiting for SSH daemon"
    exit 6
  fi
  if (( now - last_ssh_log >= 15 )); then
    last_ssh_log="$now"
    printf '[ssh] endpoint published, daemon/auth not ready yet (%ss elapsed)...\n' "$(( now - start_epoch ))"
  fi
  sleep 5
done
echo "[ssh] connection ready"

nohup ssh "${ssh_opts[@]}" \
  -o ExitOnForwardFailure=yes \
  -N -L "${LOCAL_PORT}:127.0.0.1:8080" \
  "${ssh_user}@${ssh_host}" \
  >"$TUNNEL_LOG" 2>&1 &
tunnel_pid=$!
sleep 2
if ! kill -0 "$tunnel_pid" >/dev/null 2>&1; then
  cat "$TUNNEL_LOG" >&2 || true
  cleanup_paid_instance "SSH tunnel failed"
  exit 7
fi

jq \
  --arg ssh_url "$ssh_url" \
  --argjson local_port "$LOCAL_PORT" \
  --argjson tunnel_pid "$tunnel_pid" \
  '. + {ssh_url:$ssh_url,local_port:$local_port,tunnel_pid:$tunnel_pid}' \
  "$STATE_FILE" > "$STATE_FILE.tmp"
mv "$STATE_FILE.tmp" "$STATE_FILE"
chmod 600 "$STATE_FILE"
sync_run_metadata "loading-model"

# Best-effort hardware snapshot. Telemetry must never prevent startup.
ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" \
  'nvidia-smi --query-gpu=timestamp,index,name,driver_version,memory.total,power.limit --format=csv,noheader 2>/dev/null || nvidia-smi 2>/dev/null || true' \
  > "$RUN_DIR/gpu-start.txt" 2>/dev/null || true

base_url="http://127.0.0.1:${LOCAL_PORT}/v1"
cat > "$ENV_FILE" <<ENV
export OPENAI_BASE_URL='${base_url}'
export OPENAI_API_BASE='${base_url}'
export OPENAI_API_KEY='${MODEL_API_KEY}'
export QWEN_MODEL='${MODEL}'
export QWEN_PROFILE='${PROFILE}'
export QWEN_VAST_INSTANCE_ID='${instance_id}'
ENV
chmod 600 "$ENV_FILE"

echo "[model] SSH tunnel is up; waiting for GGUF download + llama-server..."
last_log=0
while :; do
  if curl -fsS --connect-timeout 2 --max-time 5 \
      -H "Authorization: Bearer ${MODEL_API_KEY}" \
      "http://127.0.0.1:${LOCAL_PORT}/health" >/dev/null 2>&1; then
    ready=1
    break
  fi

  if ! kill -0 "$tunnel_pid" >/dev/null 2>&1; then
    cat "$TUNNEL_LOG" >&2 || true
    cleanup_paid_instance "SSH tunnel exited before model became ready"
    exit 7
  fi

  now="$(date +%s)"
  if (( now - start_epoch > START_TIMEOUT )); then
    echo >&2 "[model] last remote log lines:"
    ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'tail -n 20 /var/log/qwen38/server.log 2>/dev/null || true' >&2 || true
    cleanup_paid_instance "startup timeout while loading model"
    exit 8
  fi

  if (( now - last_log >= 30 )); then
    last_log="$now"
    ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'tail -n 2 /var/log/qwen38/server.log 2>/dev/null || true' 2>/dev/null | sed 's/^/[remote] /' || true
  fi
  sleep 5
done

trap - INT TERM

ready_epoch="$(date +%s)"
ready_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
startup_seconds="$(( ready_epoch - INSTANCE_STARTED_EPOCH ))"
jq --arg ready_at "$ready_at" --argjson ready_epoch "$ready_epoch" --argjson startup_seconds "$startup_seconds" \
  '. + {ready_at:$ready_at,ready_epoch:$ready_epoch,startup_seconds:$startup_seconds}' \
  "$STATE_FILE" > "$STATE_FILE.tmp"
mv "$STATE_FILE.tmp" "$STATE_FILE"
chmod 600 "$STATE_FILE"
sync_run_metadata "ready"

curl -fsS --connect-timeout 2 --max-time 5 \
  -H "Authorization: Bearer ${MODEL_API_KEY}" \
  "http://127.0.0.1:${LOCAL_PORT}/metrics" > "$RUN_DIR/metrics-ready.prom" 2>/dev/null || true

printf '\nREADY\n' 
printf '  Profile:   %s (sm_%s)\n' "$PROFILE" "$CUDA_ARCH"
printf '  Image:     %s\n' "$SELECTED_IMAGE"
printf '  GPU:       %s\n' "$gpu_name"
printf '  Cost:      $%.4f/h\n' "$dph"
printf '  Context:   %s\n' "$CTX_SIZE"
printf '  API:       %s\n' "$base_url"
printf '  Instance:  %s\n' "$instance_id"
printf '  Run log:   %s\n' "$RUN_DIR"
printf '\nRun: source .qwen-vast/env\n'
printf 'Stop billing: ./qwen-down --yes\n'
