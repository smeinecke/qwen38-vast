#!/usr/bin/env bash
set -Eeuo pipefail

# Vast returns decimal numbers with a dot. Force locale-independent numeric
# parsing/printf so German locales do not turn 0.4167 into an invalid number.
export LC_NUMERIC=C

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT_DIR/.qwen-vast"
STATE_FILE="$STATE_DIR/state.json"
ENV_FILE="$STATE_DIR/env"
KNOWN_HOSTS="$STATE_DIR/known_hosts"
TUNNEL_LOG="$STATE_DIR/tunnel.log"

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-lib.sh"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

qwen_source_env

# shellcheck disable=SC1091
source "$ROOT_DIR/.qwen-cache-lib.sh"
qwen_cache_load_config
qwen_cache_validate_config

# Source the restart function here so it can be called early.
# shellcheck source=/dev/stdin
source /dev/stdin <<'QWEN_UP_RESTART'
qwen_up_restart() {
  local started_at started_epoch instance_id local_port run_dir MODEL_API_KEY
  local PROFILE SELECTED_IMAGE CUDA_ARCH CTX_SIZE MODEL gpu_name dph
  local USE_FASTMTP HF_REVISION REASONING_EFFORT cache_type_k cache_type_v
  local cache_signature cache_remote_dir state_cache_enabled
  local slot_cache_session slot_cache_host slot_cache_port slot_cache_user slot_cache_root slot_cache_max_gb
  local ssh_url ssh_user ssh_host ssh_port
  local -a ssh_opts
  local tunnel_pid="" base_url=""
  local start_epoch now ready=0
  local remote_log_bytes=0
  local last_tunnel_log=0
  local runtime_preflight runtime_preflight_rc
  local last_ssh_log=0
  local last_boot_log=0
  local n_restored n_read restore_rc

  [[ -f "$STATE_FILE" ]] || { echo >&2 "ERROR: no state to restart. Run ./qwen-up first."; exit 2; }

  # Load core state. Defaults mirror the normal qwen-up flow.
  instance_id="$(jq -r '.instance_id // empty' "$STATE_FILE")"
  [[ -n "$instance_id" ]] || { echo >&2 "ERROR: state missing instance_id"; exit 2; }

  local status
  status="$(jq -r '.status // "unknown"' "$STATE_FILE")"
  if [[ "$status" != "paused" ]]; then
    echo >&2 "[restart] warning: state status is '$status', not 'paused'; continuing anyway."
  fi

  PROFILE="$(jq -r '.profile // empty' "$STATE_FILE")"
  SELECTED_IMAGE="$(jq -r '.image // empty' "$STATE_FILE")"
  CUDA_ARCH="$(jq -r '.cuda_arch // empty' "$STATE_FILE")"
  CTX_SIZE="$(jq -r '.ctx_size // 0' "$STATE_FILE")"
  MODEL="$(jq -r '.model // empty' "$STATE_FILE")"
  HF_REVISION="$(jq -r '.hf_revision // empty' "$STATE_FILE")"
  USE_FASTMTP="$(jq -r '.use_fastmtp // 1' "$STATE_FILE")"
  REASONING_EFFORT="$(jq -r '.reasoning_effort // "xhigh"' "$STATE_FILE")"
  cache_type_k="$(jq -r '.cache_type_k // "default"' "$STATE_FILE")"
  cache_type_v="$(jq -r '.cache_type_v // "default"' "$STATE_FILE")"
  cache_signature="$(jq -r '.slot_cache_signature // empty' "$STATE_FILE")"
  cache_remote_dir="$(jq -r '.slot_cache_remote_dir // empty' "$STATE_FILE")"
  state_cache_enabled="$(jq -r '.slot_cache_enabled // 0' "$STATE_FILE")"
  slot_cache_session="$(jq -r '.slot_cache_session // "default"' "$STATE_FILE")"
  slot_cache_host="$(jq -r '.slot_cache_host // empty' "$STATE_FILE")"
  slot_cache_port="$(jq -r '.slot_cache_port // 22' "$STATE_FILE")"
  slot_cache_user="$(jq -r '.slot_cache_user // empty' "$STATE_FILE")"
  slot_cache_root="$(jq -r '.slot_cache_root // empty' "$STATE_FILE")"
  slot_cache_max_gb="$(jq -r '.slot_cache_max_gb // 80' "$STATE_FILE")"

  # Cache lib requires these in the environment.
  QWEN_SLOT_CACHE_ENABLED="$state_cache_enabled"
  QWEN_SLOT_CACHE_HOST="$slot_cache_host"
  QWEN_SLOT_CACHE_PORT="$slot_cache_port"
  QWEN_SLOT_CACHE_USER="$slot_cache_user"
  QWEN_SLOT_CACHE_ROOT="$slot_cache_root"
  QWEN_SLOT_CACHE_SESSION="$slot_cache_session"
  QWEN_SLOT_CACHE_MAX_GB="$slot_cache_max_gb"

  gpu_name="$(jq -r '.gpu // "unknown"' "$STATE_FILE")"
  dph="$(jq -r '.dph // 0' "$STATE_FILE")"

  MODEL_API_KEY="$(jq -r '.api_key // empty' "$STATE_FILE")"
  [[ -n "$MODEL_API_KEY" ]] || { echo >&2 "ERROR: state missing api_key"; exit 2; }

  run_dir="$(jq -r '.run_dir // empty' "$STATE_FILE")"
  [[ -n "$run_dir" ]] || { echo >&2 "ERROR: state missing run_dir"; exit 2; }
  RUN_DIR="$run_dir"

  started_at="$(jq -r '.started_at // empty' "$STATE_FILE")"
  started_epoch="$(jq -r '.started_epoch // empty' "$STATE_FILE")"
  [[ "$started_epoch" =~ ^[0-9]+$ ]] || started_epoch="$(date +%s)"
  INSTANCE_STARTED_AT="$started_at"
  INSTANCE_STARTED_EPOCH="$started_epoch"

  RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  RUN_STARTED_EPOCH="$(date +%s)"

  mkdir -p "$RUN_DIR"
  chmod 700 "$RUN_DIR" 2>/dev/null || true
  CLIENT_LOG="$RUN_DIR/client-restart.log"
  exec > >(tee -a "$CLIENT_LOG") 2> >(tee -a "$CLIENT_LOG" >&2)

  jq --arg status "restarting" --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    'del(.api_key,.tunnel_pid) + {status:$status,metadata_updated_at:$updated_at}' \
    "$STATE_FILE" > "$RUN_DIR/metadata.json.tmp" && \
    mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json"
  chmod 600 "$RUN_DIR/metadata.json"

  # If Vast has the instance stopped, start it. This is the resume side of
  # qwen-down --pause and preserves the local disk.
  local actual_status
  actual_status="$(vastai show instance "$instance_id" --raw 2>/dev/null | jq -r '.actual_status // .status // "unknown"' 2>/dev/null || echo unknown)"
  if [[ "$actual_status" != "running" ]]; then
    echo "[restart] instance $instance_id is $actual_status; starting..."
    if ! qwen_start_instance "$instance_id" 180; then
      echo >&2 "ERROR: failed to start instance $instance_id"
      [[ -n "$QWEN_START_OUTPUT" ]] && printf '%s\n' "$QWEN_START_OUTPUT" >&2
      exit 3
    fi
  fi

  # Wait for an SSH endpoint from Vast and update local state.
  start_epoch="$(date +%s)"
  while :; do
    now="$(date +%s)"
    if (( now - start_epoch > START_TIMEOUT )); then
      echo >&2 "ERROR: restart timeout waiting for SSH endpoint"
      exit 6
    fi
    if qwen_refresh_ssh_state >/dev/null 2>&1; then
      break
    fi
    if (( now - last_boot_log >= 15 )); then
      last_boot_log="$now"
      echo "[restart] waiting for SSH endpoint..."
    fi
    sleep 5
  done

  ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"
  ssh_user="$(jq -r '.ssh_user // empty' "$STATE_FILE")"
  ssh_host="$(jq -r '.ssh_host // empty' "$STATE_FILE")"
  ssh_port="$(jq -r '.ssh_port // 0' "$STATE_FILE")"
  mapfile -d '' -t ssh_opts < <(qwen_ssh_opts "$ssh_port")
  qwen_ssh_sanitize_known_hosts "$ssh_host" "$ssh_port"

  # Wait for sshd in the container.
  while ! ssh -n -o ConnectTimeout=3 "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" true >/dev/null 2>&1; do
    now="$(date +%s)"
    if (( now - start_epoch > START_TIMEOUT )); then
      echo >&2 "ERROR: restart timeout waiting for SSH daemon"
      exit 6
    fi
    if (( now - last_ssh_log >= 15 )); then
      last_ssh_log="$now"
      echo "[restart] waiting for SSH daemon..."
    fi
    sleep 5
  done

  # Runtime preflight (same as fresh qwen-up).
  runtime_preflight_rc=0
  runtime_preflight="$(ssh -n "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" '
    set +e
    /usr/local/bin/llama-server --version >/tmp/qwen-llama-version.out 2>/tmp/qwen-llama-version.err
    rc=$?
    if [ "$rc" -ne 0 ]; then
      cat /tmp/qwen-llama-version.err
      echo "--- ldd ---"
      ldd /usr/local/bin/llama-server 2>&1 | grep -E "not found|libgomp" || true
    fi
    exit "$rc"
  ' 2>&1)" || runtime_preflight_rc=$?
  if (( runtime_preflight_rc != 0 )); then
    echo >&2 "[runtime] ERROR: remote llama-server preflight failed:"
    printf '%s\n' "$runtime_preflight" >&2
    exit 7
  fi

  # If the user passed --local-port, override the persisted port before
  # qwen_ensure_tunnel re-establishes the tunnel.
  if [[ -n "${local_port_arg:-}" ]]; then
    jq --argjson p "$local_port_arg" '. + {local_port:$p}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi

  # Establish the local SSH tunnel.
  if ! qwen_ensure_tunnel 0; then
    echo >&2 "ERROR: SSH tunnel failed"
    exit 7
  fi
  LOCAL_PORT="$(jq -r '.local_port' "$STATE_FILE")"
  tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
  ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"

  base_url="http://127.0.0.1:${LOCAL_PORT}/v1"
  cat > "$ENV_FILE" <<ENV
export OPENAI_BASE_URL='${base_url}'
export OPENAI_API_BASE='${base_url}'
export OPENAI_API_KEY='${MODEL_API_KEY}'
export QWEN_MODEL='${MODEL}'
export QWEN_PROFILE='${PROFILE}'
export QWEN_VAST_INSTANCE_ID='${instance_id}'
ENV
  chmod 600 "$ENV_FILE"

  # Wait for the model and stream the remote server log while it loads.
  echo "[model] SSH tunnel is up; waiting for llama-server..."
  local remote_status start_exit_rc new_total new_log_b64 new_log_output
  remote_status="$(qwen_remote_startup_status "$ssh_url" 0 "count" 2>/dev/null || true)"
  remote_log_bytes="$(printf '%s\n' "$remote_status" | sed -n 's/^__QWEN_LOG_BYTES__://p')"
  remote_log_bytes="${remote_log_bytes:-0}"
  while :; do
    now="$(date +%s)"
    if curl -fsS --connect-timeout 2 --max-time 5 \
        -H "Authorization: Bearer ${MODEL_API_KEY}" \
        "http://127.0.0.1:${LOCAL_PORT}/health" >/dev/null 2>&1; then
      ready=1
      break
    fi
    if [[ -z "$tunnel_pid" ]] || ! kill -0 "$tunnel_pid" >/dev/null 2>&1; then
      jq 'del(.tunnel_pid)' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
      if qwen_ensure_tunnel 1; then
        LOCAL_PORT="$(jq -r '.local_port' "$STATE_FILE")"
        tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
        echo "[tunnel] SSH tunnel reconnected on localhost:$LOCAL_PORT (pid $tunnel_pid)"
        base_url="http://127.0.0.1:${LOCAL_PORT}/v1"
        cat > "$ENV_FILE" <<ENV
export OPENAI_BASE_URL='${base_url}'
export OPENAI_API_BASE='${base_url}'
export OPENAI_API_KEY='${MODEL_API_KEY}'
export QWEN_MODEL='${MODEL}'
export QWEN_PROFILE='${PROFILE}'
export QWEN_VAST_INSTANCE_ID='${instance_id}'
ENV
        chmod 600 "$ENV_FILE"
      else
        if (( now - last_tunnel_log >= 30 )); then
          last_tunnel_log="$now"
          echo >&2 "[tunnel] SSH connection temporarily unavailable; waiting..."
        fi
        sleep 5
        continue
      fi
    fi
    remote_status="$(qwen_remote_startup_status "$ssh_url" "$remote_log_bytes" 2>/dev/null || true)"
    start_exit_rc="$(printf '%s\n' "$remote_status" | sed -n 's/^__QWEN_START_EXIT__://p')"
    new_total="$(printf '%s\n' "$remote_status" | sed -n 's/^__QWEN_LOG_BYTES__://p')"
    new_log_b64="$(printf '%s\n' "$remote_status" | sed '1,2d')"
    if [[ -n "$new_log_b64" ]]; then
      new_log_output="$(printf '%s' "$new_log_b64" | base64 -d 2>/dev/null)"
      if [[ -n "$new_log_output" ]]; then
        # Print raw so CR-based progress bars overwrite in place; only add a final
        # newline if the chunk does not already end with a newline or CR.
        printf '%s' "$new_log_output"
        if [[ "${new_log_output: -1}" != $'\n' && "${new_log_output: -1}" != $'\r' ]]; then
          printf '\n'
        fi
      fi
    fi
    if [[ "$new_total" =~ ^[0-9]+$ ]]; then
      remote_log_bytes="$new_total"
    fi
    if [[ "$start_exit_rc" =~ ^[0-9]+$ ]]; then
      echo >&2 "[model] ERROR: remote start.sh exited with rc=$start_exit_rc"
      [[ -n "$tunnel_pid" ]] && kill "$tunnel_pid" >/dev/null 2>&1 || true
      local fail_reason="remote model server exited (rc=$start_exit_rc)"
      local fail_ended_at
      fail_ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      jq --arg reason "$fail_reason" --arg ended_at "$fail_ended_at" \
        '. + {failure_reason:$reason,ended_at:$ended_at,status:"failed"}' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
      if [[ -f "$RUN_DIR/metadata.json" ]]; then
        jq --arg reason "$fail_reason" --arg ended_at "$fail_ended_at" \
          '. + {status:"failed",failure_reason:$reason,ended_at:$ended_at}' "$RUN_DIR/metadata.json" > "$RUN_DIR/metadata.json.tmp" 2>/dev/null && mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json" || true
      fi
      exit 8
    fi
    if (( now - start_epoch > START_TIMEOUT )); then
      echo >&2 "[model] last remote log lines:"
      ssh -n "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'tail -n 20 /var/log/qwen38/server.log 2>/dev/null || true' >&2 || true
      exit 8
    fi
    sleep 5
  done

  # Best-effort restore of the previously saved slot cache. The snapshot file
  # should still be on the paused instance's disk.
  if [[ "$state_cache_enabled" == "1" && -n "$cache_signature" ]]; then
    echo "[slot-cache] restoring saved slot cache..."
    restore_rc=0
    curl -fsS --connect-timeout 3 --max-time 600 \
      -X POST \
      -H "Authorization: Bearer ${MODEL_API_KEY}" \
      -H 'Content-Type: application/json' \
      -d '{"filename":"current.bin"}' \
      "http://127.0.0.1:${LOCAL_PORT}/slots/${QWEN_SLOT_CACHE_SLOT_ID}?action=restore" > "$RUN_DIR/cache-restore.json" || restore_rc=$?
    if (( restore_rc == 0 )); then
      n_restored="$(jq -r '.n_restored // 0' "$RUN_DIR/cache-restore.json" 2>/dev/null || echo 0)"
      n_read="$(jq -r '.n_read // 0' "$RUN_DIR/cache-restore.json" 2>/dev/null || echo 0)"
      echo "[slot-cache] restore API reported n_restored=${n_restored}, bytes=${n_read}"
      jq --arg status "restored" --argjson n_restored "${n_restored:-0}" --argjson n_read "${n_read:-0}" \
        '. + {slot_cache_restore:$status,slot_cache_n_restored:$n_restored,slot_cache_bytes_restored:$n_read}' \
        "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    else
      echo >&2 "[slot-cache] WARNING: slot restore API failed; continuing cold."
      jq '. + {slot_cache_restore:"restore-api-failed"}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    fi
    chmod 600 "$STATE_FILE"
  fi

  trap - INT TERM
  ready_epoch="$(date +%s)"
  ready_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  startup_seconds="$(( ready_epoch - INSTANCE_STARTED_EPOCH ))"
  jq --arg ready_at "$ready_at" --argjson ready_epoch "$ready_epoch" --argjson startup_seconds "$startup_seconds" \
    '. + {ready_at:$ready_at,ready_epoch:$ready_epoch,startup_seconds:$startup_seconds,status:"running"}' \
    "$STATE_FILE" > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
  chmod 600 "$STATE_FILE"

  jq --arg status "ready" --arg updated_at "$ready_at" \
    'del(.api_key,.tunnel_pid) + {status:$status,metadata_updated_at:$updated_at}' \
    "$STATE_FILE" > "$RUN_DIR/metadata.json.tmp" && \
    mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json"
  chmod 600 "$RUN_DIR/metadata.json"

  curl -fsS --connect-timeout 2 --max-time 5 \
    -H "Authorization: Bearer ${MODEL_API_KEY}" \
    "http://127.0.0.1:${LOCAL_PORT}/metrics" > "$RUN_DIR/metrics-ready.prom" 2>/dev/null || true

  printf '\nREADY\n'
  printf '  Profile:   %s (sm_%s)\n' "$PROFILE" "$CUDA_ARCH"
  printf '  Image:     %s\n' "$SELECTED_IMAGE"
  printf '  GPU:       %s\n' "$gpu_name"
  printf '  Cost:      $%.4f/h\n' "$dph"
  printf '  Context:   %s\n' "$CTX_SIZE"
  printf '  API:       %s\n' "$base_url"
  printf '  Instance:  %s\n' "$instance_id"
  printf '  Run log:   %s\n' "$RUN_DIR"
  if [[ "$state_cache_enabled" == "1" ]]; then
    printf '  Slot cache: %s (session=%s, signature=%s)\n' "$(jq -r '.slot_cache_restore // "unknown"' "$STATE_FILE")" "$slot_cache_session" "${cache_signature:-?}"
  fi
  printf '\nRun: source .qwen-vast/env\n'
  printf 'Stop billing: ./qwen-down --yes\n'
  printf 'Pause billing: ./qwen-down --pause --yes\n'
  if [[ "${QWEN_MONITOR_AUTO_START:-0}" == "1" ]]; then
    echo "[monitor] auto-start enabled"
    "$ROOT_DIR/qwen-monitor" start --threshold "${QWEN_MONITOR_THRESHOLD_PCT:-10}" --interval "${QWEN_MONITOR_INTERVAL:-60}" >/dev/null 2>&1 || \
      echo >&2 "[monitor] WARNING: could not start background price monitor"
  fi
}
QWEN_UP_RESTART

RUNS_DIR="${QWEN_RUNS_DIR:-$ROOT_DIR/.qwen-runs}"
PROFILES_FILE="${QWEN_PROFILES_FILE:-$ROOT_DIR/profiles.json}"

usage() {
  cat <<'USAGE'
Usage:
  ./qwen-up [PROFILE] [--session NAME] [--local-port PORT] [--max-price USD/HOUR] [--allow-paid-traffic]
  ./qwen-up --profile PROFILE [--session NAME] [--local-port PORT] [--max-price USD/HOUR] [--allow-paid-traffic]
  ./qwen-up --restart [--local-port PORT]

Restart/resume an existing paused Vast instance from .qwen-vast/state.json.
With --restart, qwen-up does not search the market or create a new instance;
it calls vastai start instance, re-establishes the SSH tunnel and waits for
llama-server to be ready.

Profiles are defined in profiles.json. Edit that file to change GPU queries,
context defaults or profile aliases without touching qwen-up.
USAGE
  if command -v jq >/dev/null 2>&1 && [[ -f "$PROFILES_FILE" ]]; then
    jq -r '
      .profiles[] |
      "  \(.name)\tctx=\(.ctx_size)\timage=\(.image)" +
      (if ((.aliases // []) | length) > 0 then "\taliases=" + ((.aliases // []) | join(",")) else "" end)
    ' "$PROFILES_FILE" 2>/dev/null || true
  fi
  cat <<'USAGE'

Examples:
  ./qwen-up a6000
  ./qwen-up a6000-128k
  ./qwen-up blackwell-128k
  ./qwen-up a6000-128k --session my-project
  ./qwen-up v100-128k --max-price 0.22 --allow-paid-traffic
  CTX_SIZE_OVERRIDE=98304 ./qwen-up a6000

Use *_OVERRIDE variables only for intentional one-off tests.
USAGE
}

profile_arg=""
cache_session_arg=""
local_port_arg=""
max_price_arg=""
allow_paid_arg=""
RESTART=0
while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -p|--profile)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --profile requires a value"; exit 2; }
      profile_arg="$2"
      shift 2
      ;;
    -s|--session)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --session requires a value"; exit 2; }
      cache_session_arg="$2"
      shift 2
      ;;
    -l|--local-port)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --local-port requires a value"; exit 2; }
      if [[ ! "${2:-}" =~ ^[0-9]+$ ]]; then
        echo >&2 "ERROR: --local-port must be a number"
        usage >&2
        exit 2
      fi
      local_port_arg="$2"
      shift 2
      ;;
    --max-price)
      [[ -n "${2:-}" ]] || { echo >&2 "ERROR: --max-price requires a value"; exit 2; }
      if [[ ! "${2:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo >&2 "ERROR: --max-price must be a positive number"
        usage >&2
        exit 2
      fi
      max_price_arg="$2"
      shift 2
      ;;
    --allow-paid-traffic)
      allow_paid_arg=1
      shift
      ;;
    --restart)
      RESTART=1
      shift
      ;;
    -*)
      echo >&2 "ERROR: unknown option: $1"
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$profile_arg" ]]; then
        echo >&2 "ERROR: multiple profiles supplied ('$profile_arg' and '$1')"
        usage >&2
        exit 2
      fi
      profile_arg="$1"
      shift
      ;;
  esac
done

if [[ -n "$local_port_arg" ]]; then
  LOCAL_PORT="$local_port_arg"
fi

if [[ -n "$cache_session_arg" ]]; then
  QWEN_SLOT_CACHE_SESSION="$cache_session_arg"
fi

if [[ -n "$max_price_arg" ]]; then
  MAX_DPH="$max_price_arg"
fi

if [[ -n "$allow_paid_arg" ]]; then
  QWEN_ALLOW_PAID_TRAFFIC="$allow_paid_arg"
fi
# Validate again after CLI overrides. The initial validation above catches bad
# .env values before any paid resources are touched.
qwen_cache_validate_config

if (( RESTART == 1 )); then
  qwen_up_restart
  exit 0
fi

command -v jq >/dev/null 2>&1 || { echo >&2 "ERROR: missing dependency: jq"; exit 2; }
[[ -f "$PROFILES_FILE" ]] || { echo >&2 "ERROR: profiles file not found: $PROFILES_FILE"; exit 2; }
jq -e '.schema_version == 1 and (.images|type=="array") and (.profiles|type=="array")' "$PROFILES_FILE" >/dev/null \
  || { echo >&2 "ERROR: invalid profiles file: $PROFILES_FILE"; exit 2; }

DEFAULT_PROFILE="$(jq -r '.default_profile // "a6000"' "$PROFILES_FILE")"
PROFILE_INPUT="${profile_arg:-${QWEN_PROFILE:-$DEFAULT_PROFILE}}"
PROFILE_JSON="$(jq -c --arg p "$PROFILE_INPUT" '
  [.profiles[] | select(.name == $p or (((.aliases // []) | index($p)) != null))][0] // empty
' "$PROFILES_FILE")"
if [[ -z "$PROFILE_JSON" || "$PROFILE_JSON" == "null" ]]; then
  echo >&2 "ERROR: unknown profile '$PROFILE_INPUT'"
  usage >&2
  exit 2
fi

PROFILE="$(jq -r '.name' <<<"$PROFILE_JSON")"
IMAGE_NAME="$(jq -r '.image' <<<"$PROFILE_JSON")"
PROFILE_CTX_SIZE="$(jq -r '.ctx_size' <<<"$PROFILE_JSON")"
PROFILE_GPU_QUERY="$(jq -r '.gpu_query' <<<"$PROFILE_JSON")"
MONITOR_GROUP="$(jq -r '.monitor_group // empty' <<<"$PROFILE_JSON")"
IMAGE_JSON="$(jq -c --arg image "$IMAGE_NAME" '[.images[] | select(.name == $image)][0] // empty' "$PROFILES_FILE")"
if [[ -z "$IMAGE_JSON" || "$IMAGE_JSON" == "null" ]]; then
  echo >&2 "ERROR: profile '$PROFILE' references unknown image '$IMAGE_NAME'"
  exit 2
fi
IMAGE_TAG="$(jq -r '.image_tag' <<<"$IMAGE_JSON")"
CUDA_ARCH="$(jq -r '.cuda_arch' <<<"$IMAGE_JSON")"

# Migration guard: older revisions used CTX_SIZE/GPU_QUERY directly in .env.
# Ignore them here so choosing a profile on the CLI always does what it says.
# Explicit *_OVERRIDE values are still available for one-off experiments.
if [[ -n "${CTX_SIZE:-}" ]]; then
  echo >&2 "[config] note: legacy CTX_SIZE is ignored; use CTX_SIZE_OVERRIDE instead."
fi
if [[ -n "${GPU_QUERY:-}" ]]; then
  echo >&2 "[config] note: legacy GPU_QUERY is ignored; use GPU_QUERY_OVERRIDE instead."
fi

CTX_SIZE="${CTX_SIZE_OVERRIDE:-$PROFILE_CTX_SIZE}"
GPU_QUERY="${GPU_QUERY_OVERRIDE:-$PROFILE_GPU_QUERY}"
MAX_DPH="${MAX_DPH:-0.80}"
REQUIRE_FREE_TRAFFIC="$(jq -r '.market_policy.require_free_traffic // true' "$PROFILES_FILE")"
MAX_INET_DOWN_COST="$(jq -r '.market_policy.max_inet_down_cost // 0' "$PROFILES_FILE")"
MAX_INET_UP_COST="$(jq -r '.market_policy.max_inet_up_cost // 0' "$PROFILES_FILE")"
ALLOW_PAID_TRAFFIC="${QWEN_ALLOW_PAID_TRAFFIC:-0}"
if [[ "$REQUIRE_FREE_TRAFFIC" == "true" && "$ALLOW_PAID_TRAFFIC" != "1" ]]; then
  # Vast exposes inet_{down,up}_cost as USD/GB. Keep this policy centralized
  # rather than duplicating it across every GPU profile.
  GPU_QUERY+=" inet_down_cost<=${MAX_INET_DOWN_COST} inet_up_cost<=${MAX_INET_UP_COST}"
fi
if qwen_cache_enabled; then
  # A slot snapshot is first written to local Vast disk before it is uploaded.
  # 100 GB avoids failing a long-context save for lack of scratch space.
  DISK_GB="${DISK_GB:-100}"
else
  DISK_GB="${DISK_GB:-60}"
fi
LOCAL_PORT="${LOCAL_PORT:-18080}"
LOCAL_PORT_AUTO="${LOCAL_PORT_AUTO:-1}"
START_TIMEOUT="${START_TIMEOUT:-1200}"
KEEP_ON_FAILURE="${KEEP_ON_FAILURE:-0}"
MODEL="${MODEL:-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf}"
USE_FASTMTP="${USE_FASTMTP:-1}"
REASONING_EFFORT="${REASONING_EFFORT:-xhigh}"
HF_REVISION="${HF_REVISION:-993a5971fda8f30dd1b7eb2654792ba4415c7460}"
LABEL="${VAST_LABEL:-qwen38-${PROFILE}-$(date +%s)}"

# Prefer the new repository-only setting. For compatibility, an old
# GHCR_IMAGE=...:latest value is accepted as a source for the repository name;
# its old tag is deliberately replaced by the selected stable profile tag.
if [[ -n "${GHCR_IMAGE_BASE:-}" ]]; then
  image_base="${GHCR_IMAGE_BASE%/}"
elif [[ -n "${GHCR_IMAGE:-}" && "$GHCR_IMAGE" != *"OWNER/REPO"* ]]; then
  image_base="${GHCR_IMAGE%:*}"
else
  image_base=""
fi

if [[ -z "$image_base" || "$image_base" == *"OWNER/REPO"* ]]; then
  echo >&2 "ERROR: set GHCR_IMAGE_BASE in .env, e.g. ghcr.io/yourname/qwen38-vast"
  exit 2
fi

SELECTED_IMAGE="${GHCR_IMAGE_OVERRIDE:-${image_base}:${IMAGE_TAG}}"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "ERROR: missing dependency: $1"
    exit 2
  }
}

for cmd in vastai jq curl ssh scp python3 openssl; do need "$cmd"; done

if qwen_cache_enabled; then
  qwen_cache_require_key
  if qwen_cache_local_preflight; then
    echo "[slot-cache] preflight OK: ${QWEN_SLOT_CACHE_USER}@${QWEN_SLOT_CACHE_HOST}:${QWEN_SLOT_CACHE_PORT}/${QWEN_SLOT_CACHE_ROOT}"
  else
    echo >&2 "[slot-cache] WARNING: cache server preflight failed from this workstation; continuing and retrying from the Vast host."
  fi
fi

if [[ -f "$STATE_FILE" ]]; then
  old_id="$(jq -r '.instance_id // empty' "$STATE_FILE" 2>/dev/null || true)"
  if [[ -n "$old_id" ]]; then
    if old_json="$(vastai show instance "$old_id" --raw 2>/dev/null)"; then
      old_status="$(jq -r '.actual_status // .status // "unknown"' <<<"$old_json" 2>/dev/null || echo unknown)"
      if [[ "$old_status" != "exited" && "$old_status" != "offline" ]]; then
        echo >&2 "ERROR: state file already references Vast instance $old_id ($old_status)."
        echo >&2 "Run ./qwen-status or ./qwen-down first."
        exit 3
      fi
    fi
  fi
  rm -f "$STATE_FILE" "$ENV_FILE" "$TUNNEL_LOG" "$KNOWN_HOSTS"
fi

# Clear stale market-monitor state only after confirming we are not replacing a
# live instance. A previous daemon may have died without removing its pid file.
if [[ -x "$ROOT_DIR/qwen-monitor" ]]; then
  "$ROOT_DIR/qwen-monitor" stop --quiet >/dev/null 2>&1 || true
fi
rm -f "$STATE_DIR/monitor-alert.json" "$STATE_DIR/monitor.last.json"

if ! qwen_port_is_free "$LOCAL_PORT"; then
  if [[ "$LOCAL_PORT_AUTO" == "1" ]]; then
    requested_port="$LOCAL_PORT"
    LOCAL_PORT="$(qwen_find_free_port "$(( LOCAL_PORT + 1 ))" 100 2>/dev/null || true)"
    if [[ -z "$LOCAL_PORT" ]]; then
      echo >&2 "ERROR: localhost:$requested_port is occupied and no free fallback port was found."
      exit 2
    fi
    echo >&2 "[tunnel] localhost:$requested_port is already occupied; using localhost:$LOCAL_PORT instead."
  else
    echo >&2 "ERROR: local port $LOCAL_PORT is already in use (LOCAL_PORT_AUTO=0)."
    exit 2
  fi
fi
MODEL_API_KEY="${MODEL_API_KEY:-sk-local-$(openssl rand -hex 24)}"
instance_id=""
tunnel_pid=""
cache_prefetch_pid=""
ready=0

RUN_ID="${QWEN_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-${PROFILE}-$$}"
RUN_DIR="$RUNS_DIR/$RUN_ID"
RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
RUN_STARTED_EPOCH="$(date +%s)"
mkdir -p "$RUN_DIR"
chmod 700 "$RUNS_DIR" "$RUN_DIR" 2>/dev/null || true
CLIENT_LOG="$RUN_DIR/client.log"

# Keep a local copy of qwen-up's output. The run directory is separate from
# .qwen-vast so shutdown can remove transient state without losing history.
exec > >(tee -a "$CLIENT_LOG") 2> >(tee -a "$CLIENT_LOG" >&2)

jq -n \
  --arg run_id "$RUN_ID" \
  --arg status "searching" \
  --arg started_at "$RUN_STARTED_AT" \
  --arg profile "$PROFILE" \
  --arg monitor_group "$MONITOR_GROUP" \
  --arg gpu_query "$GPU_QUERY" \
  --argjson disk_gb "$DISK_GB" \
  --arg cuda_arch "$CUDA_ARCH" \
  --arg image "$SELECTED_IMAGE" \
  --argjson ctx_size "$CTX_SIZE" \
  --arg model "$MODEL" \
  --arg hf_revision "$HF_REVISION" \
  --argjson fastmtp "$USE_FASTMTP" \
  --arg cache_type_k "${CACHE_TYPE_K:-default}" \
  --arg cache_type_v "${CACHE_TYPE_V:-default}" \
  --argjson slot_cache_enabled "$QWEN_SLOT_CACHE_ENABLED" \
  --arg slot_cache_host "$QWEN_SLOT_CACHE_HOST" \
  --arg slot_cache_user "$QWEN_SLOT_CACHE_USER" \
  --arg slot_cache_session "$QWEN_SLOT_CACHE_SESSION" \
  '{schema_version:1,run_id:$run_id,status:$status,started_at:$started_at,profile:$profile,monitor_group:$monitor_group,gpu_query:$gpu_query,disk_gb:$disk_gb,cuda_arch:$cuda_arch,image:$image,ctx_size:$ctx_size,model:$model,hf_revision:$hf_revision,use_fastmtp:$fastmtp,cache_type_k:$cache_type_k,cache_type_v:$cache_type_v,slot_cache_enabled:$slot_cache_enabled,slot_cache_host:$slot_cache_host,slot_cache_user:$slot_cache_user,slot_cache_session:$slot_cache_session}' \
  > "$RUN_DIR/metadata.json"
chmod 600 "$RUN_DIR/metadata.json"

sync_run_metadata() {
  local status="$1"
  [[ -f "$STATE_FILE" ]] || return 0
  local updated_at
  updated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  jq --arg status "$status" --arg updated_at "$updated_at" \
    'del(.api_key,.tunnel_pid) + {status:$status,metadata_updated_at:$updated_at}' \
    "$STATE_FILE" > "$RUN_DIR/metadata.json.tmp" && \
    mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json"
  chmod 600 "$RUN_DIR/metadata.json"
}

cleanup_paid_instance() {
  local reason="$1"
  [[ -n "$cache_prefetch_pid" ]] && kill "$cache_prefetch_pid" >/dev/null 2>&1 || true
  [[ -n "$tunnel_pid" ]] && kill "$tunnel_pid" >/dev/null 2>&1 || true
  if [[ -f "$STATE_FILE" ]]; then
    jq --arg reason "$reason" --arg ended_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '. + {failure_reason:$reason,ended_at:$ended_at}' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
    sync_run_metadata "failed" || true
  else
    jq --arg reason "$reason" --arg ended_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '. + {status:"failed",failure_reason:$reason,ended_at:$ended_at}' "$RUN_DIR/metadata.json" > "$RUN_DIR/metadata.json.tmp" 2>/dev/null && mv "$RUN_DIR/metadata.json.tmp" "$RUN_DIR/metadata.json" || true
  fi
  if [[ -n "$instance_id" && "$KEEP_ON_FAILURE" != "1" ]]; then
    echo >&2 "[cleanup] $reason; destroying Vast instance $instance_id to stop billing..."
    set +e
    qwen_destroy_instance "$instance_id"
    cleanup_destroy_rc=$?
    set -e
    if (( cleanup_destroy_rc == 0 )); then
      rm -f "$STATE_FILE" "$ENV_FILE"
    else
      echo >&2 "[cleanup] WARNING: Vast destroy failed/timed out (outcome=${QWEN_DESTROY_OUTCOME}, rc=$cleanup_destroy_rc). Keeping state for manual retry."
      [[ -n "$QWEN_DESTROY_OUTPUT" ]] && printf '%s\n' "$QWEN_DESTROY_OUTPUT" >&2
    fi
  elif [[ -n "$instance_id" ]]; then
    echo >&2 "[cleanup] $reason; KEEP_ON_FAILURE=1, leaving instance $instance_id running."
  fi
}

on_signal() {
  cleanup_paid_instance "interrupted"
  exit 130
}
trap on_signal INT TERM

printf '[profile] %s | sm_%s | ctx=%s | image=%s\n' "$PROFILE" "$CUDA_ARCH" "$CTX_SIZE" "$SELECTED_IMAGE"
# Apply MAX_DPH to the Vast query itself, not just the post-search filter, so
# Vast can return more cheap offers and we don't accidentally rely on dph_base.
if [[ "$GPU_QUERY" != *"dph"* ]]; then
  GPU_QUERY="$GPU_QUERY dph_total <= $MAX_DPH"
fi
printf '[search] %s\n' "$GPU_QUERY"
offers_raw="$(vastai search offers "$GPU_QUERY" --order dph_total --limit 25 --storage "$DISK_GB" --raw)"

offers="$(jq -c '
  if type == "array" then .
  elif (.offers? | type) == "array" then .offers
  elif .offers? then [.offers]
  elif (.bundles? | type) == "array" then .bundles
  else [] end
' <<<"$offers_raw")"

offer="$(jq -c --argjson max "$MAX_DPH" \
  --arg require_free "$REQUIRE_FREE_TRAFFIC" \
  --argjson allow_paid "$ALLOW_PAID_TRAFFIC" \
  --argjson max_down "$MAX_INET_DOWN_COST" \
  --argjson max_up "$MAX_INET_UP_COST" '
  [ .[]
    | ._effective_dph = (.dph_total // 999999)
    | select(._effective_dph <= $max)
    | select(
        if ($require_free == "true" and $allow_paid != 1) then
          ((.inet_down_cost // 999999) <= $max_down and (.inet_up_cost // 999999) <= $max_up)
        else true end
      )
  ]
  | sort_by(._effective_dph)
  | .[0] // empty
' <<<"$offers")"

if [[ -z "$offer" || "$offer" == "null" ]]; then
  echo >&2 "ERROR: no matching offer at or below \$$MAX_DPH/h."
  if [[ "$REQUIRE_FREE_TRAFFIC" == "true" && "$ALLOW_PAID_TRAFFIC" != "1" ]]; then
    echo >&2 "Traffic policy allows traffic up to \$0.001/GB (inet_down_cost and inet_up_cost <= 0.001)."
  fi
  echo >&2 "Raise MAX_DPH or set GPU_QUERY_OVERRIDE for this test."
  exit 4
fi

offer_id="$(jq -r '.id // .ask_contract_id // empty' <<<"$offer")"
gpu_name="$(jq -r '.gpu_name // "unknown"' <<<"$offer")"
dph="$(jq -r '._effective_dph' <<<"$offer")"
inet_down="$(jq -r '.inet_down // "?"' <<<"$offer")"
inet_down_cost="$(jq -r '.inet_down_cost // "?"' <<<"$offer")"
inet_up_cost="$(jq -r '.inet_up_cost // "?"' <<<"$offer")"
disk_bw="$(jq -r '.disk_bw // "?"' <<<"$offer")"
reliability="$(jq -r '.reliability2 // .reliability // "?"' <<<"$offer")"
location="$(jq -r '.geolocation // "?"' <<<"$offer")"

if [[ -z "$offer_id" ]]; then
  echo >&2 "ERROR: could not read offer ID from Vast response."
  exit 4
fi

printf '[rent] %s | $%.4f/h | down=%s Mbps | traffic down/up=$%s/$%s per GB | disk=%s MB/s | reliability=%s | %s | offer=%s\n' \
  "$gpu_name" "$dph" "$inet_down" "$inet_down_cost" "$inet_up_cost" "$disk_bw" "$reliability" "$location" "$offer_id"

# v7 uses Vast's normal entrypoint/args launch mode. Port 22 is a normal
# Docker mapping and sshd is part of our image; Vast no longer injects a child
# /ssh image or rewrites authorized_keys at paid-instance startup.
docker_env="-p 22:22 -e QWEN_PROFILE=${PROFILE} -e LLAMA_API_KEY=${MODEL_API_KEY} -e MODEL=${MODEL} -e CTX_SIZE=${CTX_SIZE} -e USE_FASTMTP=${USE_FASTMTP} -e REASONING_EFFORT=${REASONING_EFFORT} -e HF_REVISION=${HF_REVISION} -e BIND_HOST=127.0.0.1 -e SLOT_SAVE_PATH=${QWEN_SLOT_CACHE_LOCAL_DIR}"
if [[ -n "${CACHE_TYPE_K:-}" ]]; then
  docker_env+=" -e CACHE_TYPE_K=${CACHE_TYPE_K}"
fi
if [[ -n "${CACHE_TYPE_V:-}" ]]; then
  docker_env+=" -e CACHE_TYPE_V=${CACHE_TYPE_V}"
fi
if [[ -n "${HF_TOKEN:-}" ]]; then
  docker_env+=" -e HF_TOKEN=${HF_TOKEN}"
fi
# Optional local emergency key override; normal images already contain the key
# prepared by GitHub Actions. Encoding avoids spaces breaking Docker -e syntax.
if [[ -n "${SSH_PUBLIC_KEY:-}" ]]; then
  ssh_public_key_b64="$(python3 - <<'PYKEY'
import base64, os
print(base64.b64encode(os.environ["SSH_PUBLIC_KEY"].encode()).decode())
PYKEY
)"
  docker_env+=" -e QWEN_SSH_PUBLIC_KEY_B64=${ssh_public_key_b64}"
fi

create_raw="$(vastai create instance "$offer_id" \
  --image "$SELECTED_IMAGE" \
  --disk "$DISK_GB" \
  --label "$LABEL" \
  --env "$docker_env" \
  --raw \
  --args qwen38)" || {
    echo >&2 "ERROR: Vast failed to create the instance."
    exit 5
  }

instance_id="$(jq -r '.new_contract // .instance_id // .id // empty' <<<"$create_raw")"
if [[ -z "$instance_id" ]]; then
  echo >&2 "ERROR: Vast create response did not contain an instance ID:"
  echo >&2 "$create_raw"
  exit 5
fi

INSTANCE_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
INSTANCE_STARTED_EPOCH="$(date +%s)"

jq -n \
  --argjson instance_id "$instance_id" \
  --arg offer_id "$offer_id" \
  --arg gpu "$gpu_name" \
  --argjson dph "$dph" \
  --argjson local_port "$LOCAL_PORT" \
  --arg model "$MODEL" \
  --arg hf_revision "$HF_REVISION" \
  --argjson ctx "$CTX_SIZE" \
  --arg api_key "$MODEL_API_KEY" \
  --arg image "$SELECTED_IMAGE" \
  --arg label "$LABEL" \
  --arg profile "$PROFILE" \
  --arg monitor_group "$MONITOR_GROUP" \
  --arg gpu_query "$GPU_QUERY" \
  --argjson disk_gb "$DISK_GB" \
  --arg cuda_arch "$CUDA_ARCH" \
  --arg run_id "$RUN_ID" \
  --arg run_dir "$RUN_DIR" \
  --arg started_at "$INSTANCE_STARTED_AT" \
  --argjson started_epoch "$INSTANCE_STARTED_EPOCH" \
  --arg run_started_at "$RUN_STARTED_AT" \
  --argjson run_started_epoch "$RUN_STARTED_EPOCH" \
  --arg location "$location" \
  --arg inet_down "$inet_down" \
  --arg inet_down_cost "$inet_down_cost" \
  --arg inet_up_cost "$inet_up_cost" \
  --arg disk_bw "$disk_bw" \
  --arg reliability "$reliability" \
  --argjson fastmtp "$USE_FASTMTP" \
  --arg reasoning_effort "$REASONING_EFFORT" \
  --arg cache_type_k "${CACHE_TYPE_K:-default}" \
  --arg cache_type_v "${CACHE_TYPE_V:-default}" \
  --argjson slot_cache_enabled "$QWEN_SLOT_CACHE_ENABLED" \
  --arg slot_cache_host "$QWEN_SLOT_CACHE_HOST" \
  --argjson slot_cache_port "$QWEN_SLOT_CACHE_PORT" \
  --arg slot_cache_user "$QWEN_SLOT_CACHE_USER" \
  --arg slot_cache_root "$QWEN_SLOT_CACHE_ROOT" \
  --arg slot_cache_session "$QWEN_SLOT_CACHE_SESSION" \
  --argjson slot_cache_max_gb "$QWEN_SLOT_CACHE_MAX_GB" \
  '{schema_version:1,instance_id:$instance_id,offer_id:$offer_id,gpu:$gpu,dph:$dph,local_port:$local_port,model:$model,hf_revision:$hf_revision,ctx_size:$ctx,api_key:$api_key,image:$image,label:$label,profile:$profile,monitor_group:$monitor_group,gpu_query:$gpu_query,disk_gb:$disk_gb,cuda_arch:$cuda_arch,run_id:$run_id,run_dir:$run_dir,started_at:$started_at,started_epoch:$started_epoch,run_started_at:$run_started_at,run_started_epoch:$run_started_epoch,location:$location,inet_down:$inet_down,inet_down_cost:$inet_down_cost,inet_up_cost:$inet_up_cost,disk_bw:$disk_bw,reliability:$reliability,use_fastmtp:$fastmtp,reasoning_effort:$reasoning_effort,cache_type_k:$cache_type_k,cache_type_v:$cache_type_v,slot_cache_enabled:$slot_cache_enabled,slot_cache_host:$slot_cache_host,slot_cache_port:$slot_cache_port,slot_cache_user:$slot_cache_user,slot_cache_root:$slot_cache_root,slot_cache_session:$slot_cache_session,slot_cache_max_gb:$slot_cache_max_gb}' \
  > "$STATE_FILE"
chmod 600 "$STATE_FILE"
sync_run_metadata "provisioning"

echo "[boot] Vast instance $instance_id created; waiting for mapped SSH port..."
start_epoch="$(date +%s)"
ssh_url=""
ssh_user=""
ssh_host=""
ssh_port=""
last_boot_log=0
while :; do
  now="$(date +%s)"
  if (( now - start_epoch > START_TIMEOUT )); then
    cleanup_paid_instance "startup timeout while waiting for SSH"
    exit 6
  fi

  instance_json="$(vastai show instance "$instance_id" --raw 2>/dev/null || true)"
  status="$(jq -r '.actual_status // .status // "loading"' <<<"${instance_json:-{}}" 2>/dev/null || echo loading)"
  case "$status" in
    exited|unknown|offline)
      cleanup_paid_instance "instance entered status '$status'"
      exit 6
      ;;
  esac

  endpoint="$(qwen_resolve_ssh_endpoint "$instance_id" "$instance_json" 2>/dev/null || true)"
  if [[ -n "$endpoint" ]]; then
    IFS=$'\t' read -r ssh_user ssh_host ssh_port ssh_url <<<"$endpoint"
    if [[ -n "$ssh_host" && "$ssh_port" =~ ^[0-9]+$ ]]; then
      jq --arg ssh_url "$ssh_url" --arg ssh_host "$ssh_host" --arg ssh_user "$ssh_user" --argjson ssh_port "$ssh_port" \
        '. + {ssh_url:$ssh_url,ssh_host:$ssh_host,ssh_port:$ssh_port,ssh_user:$ssh_user}' \
        "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      chmod 600 "$STATE_FILE"
      break
    fi
  fi

  if (( now - last_boot_log >= 15 )); then
    last_boot_log="$now"
    published_host="$(jq -r '.public_ipaddr // .public_ip // .ssh_host // empty' <<<"${instance_json:-{}}" 2>/dev/null || true)"
    published_port="$(jq -r '.ports["22/tcp"][0].HostPort // .ssh_port // empty' <<<"${instance_json:-{}}" 2>/dev/null || true)"
    if [[ -n "$published_host" || -n "$published_port" ]]; then
      printf '[boot] status=%s | ssh=%s:%s | waiting for complete endpoint...\n' "$status" "${published_host:-?}" "${published_port:-?}"
    else
      printf '[boot] status=%s | port 22 mapping not published yet...\n' "$status"
    fi
  fi
  sleep 5
done

mapfile -d '' -t ssh_opts < <(qwen_ssh_opts "$ssh_port")
qwen_ssh_sanitize_known_hosts "$ssh_host" "$ssh_port"
echo "[ssh] endpoint discovered: ${ssh_user}@${ssh_host}:${ssh_port}; waiting for SSH daemon..."
last_ssh_log=0
while ! ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" true >/dev/null 2>&1; do
  now="$(date +%s)"
  if (( now - start_epoch > START_TIMEOUT )); then
    cleanup_paid_instance "startup timeout while waiting for SSH daemon"
    exit 6
  fi
  if (( now - last_ssh_log >= 15 )); then
    last_ssh_log="$now"
    printf '[ssh] endpoint published, daemon/auth not ready yet (%ss elapsed)...\n' "$(( now - start_epoch ))"
  fi
  sleep 5
done
echo "[ssh] connection ready"

# Fail fast on broken runtime images. The container starts sshd first and keeps
# it alive even if the model process fails, so this reports the real loader
# error instead of degrading into repeated tunnel reconnect messages.
runtime_preflight_rc=0
runtime_preflight="$(ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" '
  set +e
  /usr/local/bin/llama-server --version >/tmp/qwen-llama-version.out 2>/tmp/qwen-llama-version.err
  rc=$?
  if [ "$rc" -ne 0 ]; then
    cat /tmp/qwen-llama-version.err
    echo "--- ldd ---"
    ldd /usr/local/bin/llama-server 2>&1 | grep -E "not found|libgomp" || true
  fi
  exit "$rc"
' 2>&1)" || runtime_preflight_rc=$?
if (( runtime_preflight_rc != 0 )); then
  echo >&2 "[runtime] ERROR: remote llama-server preflight failed:"
  printf '%s\n' "$runtime_preflight" >&2
  cleanup_paid_instance "llama-server runtime dependency failure"
  exit 7
fi
unset runtime_preflight runtime_preflight_rc

# Stage the persistent slot snapshot while the model is still downloading/loading.
# This overlaps the Vienna -> Vast transfer with the Hugging Face cold start.
cache_signature=""
cache_remote_dir=""
cache_prefetch_status="$RUN_DIR/cache-prefetch.status"
cache_prefetch_log="$RUN_DIR/cache-prefetch.log"
if qwen_cache_enabled; then
  if qwen_cache_copy_key_to_vast "$ssh_user" "$ssh_host" "$ssh_port"; then
    build_json="$(ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'cat /etc/qwen38-build.json 2>/dev/null || true' 2>/dev/null || true)"
    llama_commit="$(jq -r '.llama_cpp_commit // "unknown"' <<<"${build_json:-{\}}" 2>/dev/null)" || llama_commit="unknown"
    [[ "$llama_commit" == "unknown" || "$llama_commit" =~ ^[a-f0-9]+$ ]] || llama_commit="unknown"
    cache_signature="$(qwen_cache_signature "$llama_commit" "$MODEL" "$HF_REVISION" "$CTX_SIZE" "$USE_FASTMTP" "${CACHE_TYPE_K:-default}" "${CACHE_TYPE_V:-default}")"
    cache_remote_dir="$(qwen_cache_remote_dir "$cache_signature")"
    jq --arg signature "$cache_signature" --arg remote_dir "$cache_remote_dir" --arg llama_commit "$llama_commit" \
      '. + {slot_cache_signature:$signature,slot_cache_remote_dir:$remote_dir,llama_cpp_commit:$llama_commit,slot_cache_restore:"prefetching"}' \
      "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    chmod 600 "$STATE_FILE"
    echo "[slot-cache] prefetching session=${QWEN_SLOT_CACHE_SESSION} signature=${cache_signature} from ${QWEN_SLOT_CACHE_HOST} (in parallel with model load)"
    : > "$cache_prefetch_log"
    (
      set +e
      qwen_cache_prefetch_to_vast "$ssh_user" "$ssh_host" "$ssh_port" "$cache_signature" >>"$cache_prefetch_log" 2>&1
      rc=$?
      printf '%s\n' "$rc" > "$cache_prefetch_status"
      exit 0
    ) &
    cache_prefetch_pid=$!
  else
    echo >&2 "[slot-cache] WARNING: could not install dedicated cache key on Vast; continuing cold."
    jq '. + {slot_cache_restore:"key-install-failed"}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi
fi

# Tunnel creation is centralized in .qwen-lib.sh and serialized with a local
# lock. This prevents qwen-status/qwen-bench from racing qwen-up and creating a
# second ssh -L listener on the same port while provisioning is still ongoing.
if ! qwen_ensure_tunnel 0; then
  cleanup_paid_instance "SSH tunnel failed"
  exit 7
fi
LOCAL_PORT="$(jq -r '.local_port' "$STATE_FILE")"
tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
ssh_url="$(jq -r '.ssh_url // empty' "$STATE_FILE")"
sync_run_metadata "loading-model"

# Best-effort hardware snapshot. Telemetry must never prevent startup.
ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" \
  'nvidia-smi --query-gpu=timestamp,index,name,driver_version,memory.total,power.limit --format=csv,noheader 2>/dev/null || nvidia-smi 2>/dev/null || true' \
  > "$RUN_DIR/gpu-start.txt" 2>/dev/null || true

base_url="http://127.0.0.1:${LOCAL_PORT}/v1"
cat > "$ENV_FILE" <<ENV
export OPENAI_BASE_URL='${base_url}'
export OPENAI_API_BASE='${base_url}'
export OPENAI_API_KEY='${MODEL_API_KEY}'
export QWEN_MODEL='${MODEL}'
export QWEN_PROFILE='${PROFILE}'
export QWEN_VAST_INSTANCE_ID='${instance_id}'
ENV
chmod 600 "$ENV_FILE"

echo "[model] SSH tunnel is up; waiting for GGUF download + llama-server..."
# Start tailing from the current end of the log so we don't dump the whole file.
remote_log_init="$(qwen_remote_startup_status "$ssh_url" 0 "count" 2>/dev/null || true)"
remote_log_bytes="$(printf '%s\n' "$remote_log_init" | sed -n 's/^__QWEN_LOG_BYTES__://p')"
remote_log_bytes="${remote_log_bytes:-0}"
last_tunnel_log=0
while :; do
  now="$(date +%s)"
  if curl -fsS --connect-timeout 2 --max-time 5 \
      -H "Authorization: Bearer ${MODEL_API_KEY}" \
      "http://127.0.0.1:${LOCAL_PORT}/health" >/dev/null 2>&1; then
    ready=1
    break
  fi

  if [[ -z "$tunnel_pid" ]] || ! kill -0 "$tunnel_pid" >/dev/null 2>&1; then
    # Vast hosts can transiently restart networking/container state while the
    # image/model is still coming up. A dropped SSH tunnel is therefore not a
    # reason to destroy a paid instance immediately. Refresh the endpoint and
    # keep trying until the overall START_TIMEOUT expires.
    jq 'del(.tunnel_pid)' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || true
    if qwen_ensure_tunnel 1; then
      LOCAL_PORT="$(jq -r '.local_port' "$STATE_FILE")"
      tunnel_pid="$(jq -r '.tunnel_pid // empty' "$STATE_FILE")"
      echo "[tunnel] SSH tunnel reconnected on localhost:$LOCAL_PORT (pid $tunnel_pid)"
      base_url="http://127.0.0.1:${LOCAL_PORT}/v1"
      cat > "$ENV_FILE" <<ENV
export OPENAI_BASE_URL='${base_url}'
export OPENAI_API_BASE='${base_url}'
export OPENAI_API_KEY='${MODEL_API_KEY}'
export QWEN_MODEL='${MODEL}'
export QWEN_PROFILE='${PROFILE}'
export QWEN_VAST_INSTANCE_ID='${instance_id}'
ENV
      chmod 600 "$ENV_FILE"
    else
      if (( now - last_tunnel_log >= 30 )); then
        last_tunnel_log="$now"
        echo >&2 "[tunnel] SSH connection temporarily unavailable; waiting for Vast host to recover..."
      fi
      sleep 5
      continue
    fi
  fi

  # Poll start.sh state and stream any new server-log bytes (download/loading
  # progress, including CR-based tqdm progress bars) in a single SSH round trip.
  remote_status="$(qwen_remote_startup_status "$ssh_url" "$remote_log_bytes" 2>/dev/null || true)"
  start_exit_rc="$(printf '%s\n' "$remote_status" | sed -n 's/^__QWEN_START_EXIT__://p')"
  new_total="$(printf '%s\n' "$remote_status" | sed -n 's/^__QWEN_LOG_BYTES__://p')"
  new_log_b64="$(printf '%s\n' "$remote_status" | sed '1,2d')"
  if [[ -n "$new_log_b64" ]]; then
    new_log_output="$(printf '%s' "$new_log_b64" | base64 -d 2>/dev/null)"
    if [[ -n "$new_log_output" ]]; then
      # Print raw so CR-based progress bars overwrite in place; only add a final
      # newline if the chunk does not already end with a newline or CR.
      printf '%s' "$new_log_output"
      if [[ "${new_log_output: -1}" != $'\n' && "${new_log_output: -1}" != $'\r' ]]; then
        printf '\n'
      fi
    fi
  fi
  if [[ "$new_total" =~ ^[0-9]+$ ]]; then
    remote_log_bytes="$new_total"
  fi

  # entrypoint.sh keeps sshd alive when start.sh exits. Detect that marker
  # immediately instead of waiting for START_TIMEOUT while reconnecting a
  # perfectly healthy SSH daemon to a dead model server.
  if [[ "$start_exit_rc" =~ ^[0-9]+$ ]]; then
    echo >&2 "[model] ERROR: remote start.sh exited with rc=$start_exit_rc"
    echo >&2 "[model] last remote log lines:"
    if [[ -n "${new_log_output:-}" ]]; then
      printf '%s' "$new_log_output" >&2
      if [[ "${new_log_output: -1}" != $'\n' && "${new_log_output: -1}" != $'\r' ]]; then
        printf '\n' >&2
      fi
    fi
    cleanup_paid_instance "remote model server exited (rc=$start_exit_rc)"
    exit 8
  fi

  if (( now - start_epoch > START_TIMEOUT )); then
    echo >&2 "[model] last remote log lines:"
    ssh -n "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'tail -n 20 /var/log/qwen38/server.log 2>/dev/null || true' >&2 || true
    cleanup_paid_instance "startup timeout while loading model"
    exit 8
  fi

  sleep 5
done

# If a compatible snapshot was prefetched, restore slot 0 now that llama-server
# is healthy. A miss/failure is non-fatal and simply leaves a cold slot.
if qwen_cache_enabled && [[ -n "$cache_signature" ]]; then
  if [[ -n "$cache_prefetch_pid" ]]; then
    # Poll the remote download and show a progress bar until rsync finishes.
    # This keeps qwen-up in the foreground and visible while the snapshot is
    # being pulled from the cache server.
    local part_bytes total_bytes last_pct=""
    echo "[slot-cache] waiting for snapshot download..."
    (
      while :; do
        part_bytes="$(ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'stat -c %s /var/lib/qwen38/slots/current.bin.part 2>/dev/null || echo 0' 2>/dev/null || echo 0)"
        total_bytes="$(ssh "${ssh_opts[@]}" "${ssh_user}@${ssh_host}" 'cat /run/qwen38/cache-prefetch.total 2>/dev/null || echo 0' 2>/dev/null || echo 0)"
        if [[ "$part_bytes" =~ ^[0-9]+$ && "$total_bytes" =~ ^[0-9]+$ && "$total_bytes" -gt 0 ]]; then
          local pct
          pct="$(python3 - "$part_bytes" "$total_bytes" <<'PY'
import sys
b=int(sys.argv[1]); t=int(sys.argv[2])
if t>0: print(f"{(b/t)*100:.1f}")
else: print("0.0")
PY
)"
          if [[ "$pct" != "$last_pct" ]]; then
            printf '\r[slot-cache] download progress: %s%% (%s / %s bytes)' "$pct" "$part_bytes" "$total_bytes"
            last_pct="$pct"
          fi
        fi
        sleep 2
      done
    ) &
    local cache_prefetch_progress_pid=$!
    wait "$cache_prefetch_pid" >/dev/null 2>&1 || true
    cache_prefetch_pid=""
    kill "$cache_prefetch_progress_pid" >/dev/null 2>&1 || true
    wait "$cache_prefetch_progress_pid" >/dev/null 2>&1 || true
    printf '\n'
  fi
  prefetch_rc="$(cat "$cache_prefetch_status" 2>/dev/null || echo 99)"
  if [[ "$prefetch_rc" == "0" ]]; then
    echo "[slot-cache] snapshot downloaded; restoring slot ${QWEN_SLOT_CACHE_SLOT_ID}..."
    restore_file="$RUN_DIR/cache-restore.json"
    set +e
    curl -fsS --connect-timeout 3 --max-time 600 \
      -X POST \
      -H "Authorization: Bearer ${MODEL_API_KEY}" \
      -H 'Content-Type: application/json' \
      -d '{"filename":"current.bin"}' \
      "http://127.0.0.1:${LOCAL_PORT}/slots/${QWEN_SLOT_CACHE_SLOT_ID}?action=restore" > "$restore_file"
    restore_rc=$?
    set -e
    if (( restore_rc == 0 )); then
      n_restored="$(jq -r '.n_restored // 0' "$restore_file" 2>/dev/null || echo 0)"
      n_read="$(jq -r '.n_read // 0' "$restore_file" 2>/dev/null || echo 0)"
      echo "[slot-cache] restore API reported n_restored=${n_restored}, bytes=${n_read}"
      echo "[slot-cache] NOTE: API restore success is not proof of prefix reuse on hybrid Qwen models; qwen-bench now reports cache_n/cache-hit % on the next real request."
      jq --arg status "restored" --argjson n_restored "${n_restored:-0}" --argjson n_read "${n_read:-0}" \
        '. + {slot_cache_restore:$status,slot_cache_n_restored:$n_restored,slot_cache_bytes_restored:$n_read}' \
        "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    else
      echo >&2 "[slot-cache] WARNING: slot restore API failed; continuing cold."
      jq '. + {slot_cache_restore:"restore-api-failed"}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    fi
  elif [[ "$prefetch_rc" == "10" ]]; then
    echo "[slot-cache] no compatible persisted snapshot (cold context)."
    jq '. + {slot_cache_restore:"miss"}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  else
    echo >&2 "[slot-cache] WARNING: cache prefetch failed (rc=$prefetch_rc); continuing cold. See $cache_prefetch_log"
    jq --arg rc "$prefetch_rc" '. + {slot_cache_restore:"prefetch-failed",slot_cache_prefetch_rc:$rc}' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi
  chmod 600 "$STATE_FILE"
fi

trap - INT TERM

ready_epoch="$(date +%s)"
ready_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
startup_seconds="$(( ready_epoch - INSTANCE_STARTED_EPOCH ))"
jq --arg ready_at "$ready_at" --argjson ready_epoch "$ready_epoch" --argjson startup_seconds "$startup_seconds" \
  '. + {ready_at:$ready_at,ready_epoch:$ready_epoch,startup_seconds:$startup_seconds}' \
  "$STATE_FILE" > "$STATE_FILE.tmp"
mv "$STATE_FILE.tmp" "$STATE_FILE"
chmod 600 "$STATE_FILE"
sync_run_metadata "ready"

curl -fsS --connect-timeout 2 --max-time 5 \
  -H "Authorization: Bearer ${MODEL_API_KEY}" \
  "http://127.0.0.1:${LOCAL_PORT}/metrics" > "$RUN_DIR/metrics-ready.prom" 2>/dev/null || true

printf '\nREADY\n' 
printf '  Profile:   %s (sm_%s)\n' "$PROFILE" "$CUDA_ARCH"
printf '  Image:     %s\n' "$SELECTED_IMAGE"
printf '  GPU:       %s\n' "$gpu_name"
printf '  Cost:      $%.4f/h\n' "$dph"
printf '  Context:   %s\n' "$CTX_SIZE"
printf '  API:       %s\n' "$base_url"
printf '  Instance:  %s\n' "$instance_id"
printf '  Run log:   %s\n' "$RUN_DIR"
if qwen_cache_enabled; then
  printf '  Slot cache: %s (session=%s, signature=%s)\n' "$(jq -r '.slot_cache_restore // "unknown"' "$STATE_FILE")" "$QWEN_SLOT_CACHE_SESSION" "${cache_signature:-?}"
fi
printf '\nRun: source .qwen-vast/env\n'
printf 'Stop billing: ./qwen-down --yes\n'
if [[ "${QWEN_MONITOR_AUTO_START:-0}" == "1" ]]; then
  echo "[monitor] auto-start enabled"
  "$ROOT_DIR/qwen-monitor" start     --threshold "${QWEN_MONITOR_THRESHOLD_PCT:-10}"     --interval "${QWEN_MONITOR_INTERVAL:-60}" >/dev/null 2>&1 ||     echo >&2 "[monitor] WARNING: could not start background price monitor"
fi
