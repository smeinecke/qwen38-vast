#!/usr/bin/env python3
"""Minimal fake llama-server for LocalProvider integration tests.

Supports both Unix-socket (secure) and TCP (unsecure) mode and serves the
endpoints that hostai's up/status flow requires:
  GET /health
  GET /v1/models
  POST /v1/chat/completions
"""

import argparse
import json
import os
import socket
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse


def load_cert_pair():
    cert_dir = Path(os.environ.get("HOSTAI_CERTS_DIR", "/dev/shm/qwen38/certs"))
    cert = (cert_dir / "server.crt").read_text() if (cert_dir / "server.crt").exists() else None
    key = (cert_dir / "server.key").read_text() if (cert_dir / "server.key").exists() else None
    return cert, key


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        print(f"[fake-llama-server] {fmt % args}")

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/health":
            self._json_response(200, {"status": "ok"})
        elif parsed.path == "/v1/models":
            self._json_response(200, {"object": "list", "data": [{
                "id": "qwen3.8-27b",
                "object": "model",
                "created": 0,
                "owned_by": "hostai-test",
            }]})
        else:
            self._json_response(404, {"error": "not found"})

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path == "/v1/chat/completions":
            length = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(length).decode()) if length else {}
            model = body.get("model", "unknown")
            content = "This is a fake response from the hostai integration test server."
            self._json_response(200, {
                "id": "chatcmpl-test",
                "object": "chat.completion",
                "created": 0,
                "model": model,
                "choices": [{"index": 0, "message": {"role": "assistant", "content": content}, "finish_reason": "stop"}],
                "usage": {"prompt_tokens": 1, "completion_tokens": 10, "total_tokens": 11},
            })
        else:
            self._json_response(404, {"error": "not found"})

    def _json_response(self, status, payload):
        data = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


class UnixSocketHTTPServer(ThreadingHTTPServer):
    address_family = socket.AF_UNIX

    def server_bind(self):
        # unlink stale socket
        if isinstance(self.server_address, str) and os.path.exists(self.server_address):
            os.unlink(self.server_address)
        super().server_bind()


def wait_for_certs(sock_path):
    cert_dir = Path(os.environ.get("HOSTAI_CERTS_DIR", "/dev/shm/qwen38/certs"))
    cert_file = cert_dir / "server.crt"
    key_file = cert_dir / "server.key"
    # In unsecure mode there are no certs; in secure mode the hostai client
    # delivers them after sshd is up.  Wait a reasonable time.
    if not cert_file.exists() or not key_file.exists():
        print("[fake-llama-server] waiting for TLS certs...")
        for _ in range(60):
            if cert_file.exists() and key_file.exists():
                break
            threading.Event().wait(1)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--version", action="store_true", help="print version and exit")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--path", default="/dev/shm/qwen38/llama.sock")
    parser.add_argument("--socket", default=None)
    args = parser.parse_args()

    if args.version:
        print("fake-llama-server version 0.0.1 (hostai integration test)")
        sys.exit(0)

    unsecure = os.environ.get("HOSTAI_UNSECURE") == "1"
    if unsecure or os.environ.get("HOSTAI_LOCAL_UNSECURE") == "1":
        # TCP mode
        print(f"[fake-llama-server] listening on {args.host}:{args.port}")
        server = ThreadingHTTPServer((args.host, args.port), Handler)
        server.serve_forever()
    else:
        # Unix socket mode
        socket_path = args.socket or args.path
        Path(socket_path).parent.mkdir(parents=True, exist_ok=True)
        wait_for_certs(socket_path)
        cert, key = load_cert_pair()
        if cert and key:
            print("[fake-llama-server] TLS cert found; using HTTPS over Unix socket")
        else:
            print("[fake-llama-server] no TLS cert found; using HTTP over Unix socket")
        print(f"[fake-llama-server] listening on Unix socket {socket_path}")
        server = UnixSocketHTTPServer(socket_path, Handler)
        try:
            server.serve_forever()
        finally:
            if os.path.exists(socket_path):
                os.unlink(socket_path)


if __name__ == "__main__":
    main()
